{
  "odoo_configs": {
    "19.0_full": {
      "enabled": true,                         # Habilita o deshabilita esta configuracion base
      "admin_password": "admin",               # Password del administrador de Odoo (acceso a /web/database/manager)
      "workers": 2,                            # Numero de workers Gunicorn para peticiones concurrentes
      "without_demo": true,                    # Evita datos demo al crear nuevas bases de datos
      "list_db": true,                         # Permite listar bases de datos en /web/database/manager
      "proxy_mode": true,                      # Activa modo proxy para funcionar detras de nginx
      "limit_memory_soft": 16000000000,        # Limite de memoria suave por worker en bytes (16GB)
      "limit_memory_hard": 17000000000,        # Limite de memoria hard por worker en bytes (17GB)
      "max_cron_threads": 1,                   # Threads dedicados a cron jobs
      "limit_time_real_cron": 0,               # Limite de tiempo para cron jobs (0 = sin limite)
      "limit_time_real": 3600,                 # Tiempo maximo de ejecucion para requests HTTP en segundos
      "limit_time_cpu": 60,                    # Tiempo maximo de CPU por request en segundos
      "db_maxconn": 200,                       # Conexiones maximas a PostgreSQL por worker
      "unaccent": false,                       # Extension unaccent de PostgreSQL para busquedas sin acentos
      "server_wide_modules": "",               # Modulos cargados en todos los workers (ej: "web,base_import_module")
      "db_filter": "",                         # Filtro regex para restringir bases de datos visibles
      "db_name": "False",                      # Base de datos por defecto ("False" para deshabilitar)
      "server_mode": "test",                   # Modo del servidor: "test", "development", "production"
      "aeroo_docs_host": "aeroo",              # Host del servicio Aeroo Docs para reportes
      "custom_config": "[options]",            # Configuracion Odoo personalizada inyectada en odoo.conf
      "addons": [                              # Rutas de directorios de addons adicionales (relativos a la raiz)
        "src/enterprise",
        "src/custom/modules"
      ]
    },
    "17.0_full": {
      "enabled": true,                         # Habilita o deshabilita esta configuracion base
      "admin_password": "admin",               # Password del administrador de Odoo
      "workers": 2,                            # Numero de workers Gunicorn
      "without_demo": true,                    # Evita datos demo
      "list_db": true,                         # Permite listar bases de datos
      "proxy_mode": true,                      # Modo proxy para nginx
      "limit_memory_soft": 16000000000,        # Limite de memoria suave (16GB)
      "limit_memory_hard": 17000000000,        # Limite de memoria hard (17GB)
      "max_cron_threads": 1,                   # Threads para cron jobs
      "limit_time_real_cron": 0,               # Limite de tiempo para cron jobs
      "limit_time_real": 3600,                 # Tiempo maximo de ejecucion para requests
      "limit_time_cpu": 60,                    # Tiempo maximo de CPU por request
      "db_maxconn": 200,                       # Conexiones maximas a PostgreSQL
      "unaccent": false,                       # Sin extension unaccent
      "server_wide_modules": "",               # Modulos server-wide
      "db_filter": "",                         # Filtro de bases de datos
      "db_name": "False",                      # Base de datos por defecto
      "server_mode": "test",                   # Modo del servidor
      "aeroo_docs_host": "aeroo",              # Host de Aeroo Docs
      "custom_config": "[options]",            # Configuracion personalizada inyectada
      "addons": [                              # Directorios de addons adicionales
        "src/enterprise",
        "src/custom/modules"
      ]
    }
  },
  "databases": {
    "local_pg16": {
      "postgres_version": 16,                  # Version de PostgreSQL a usar (16, 15, 14, etc.)
      "port": 5432,                            # Puerto en el host, solo se publica si expose_host_port=true
      "expose_host_port": false,               # true: publica "port" en el host (docker-compose ports). Por defecto la DB solo es alcanzable dentro de la red interna de Docker (db-<nombre>:5432)
      "user": "odoo",                          # Usuario de PostgreSQL (tambien usado por Odoo)
      "password": "odoo",                      # Password de PostgreSQL (tambien usado por Odoo)
      "config": "postgresql.conf",             # Archivo de configuracion de PostgreSQL en .resources/dbconfigs/
      "create_container": true                 # true: Docker crea y gestiona el contenedor de PostgreSQL
    },
    "external_pg16": {
      "postgres_version": 16,                  # Version de PostgreSQL (para referencia)
      "port": 5432,                            # Puerto de la base de datos externa
      "user": "odoo",                          # Usuario de PostgreSQL
      "password": "odoo",                      # Password de PostgreSQL
      "create_container": false,               # false: No crea contenedor, conecta a base de datos externa
      "host": "192.168.1.100"                  # IP o hostname de la base de datos externa (requerido si create_container=false)
    }
  },
  "instances": {
    "client-a": {
      "enabled": true,                         # Habilita o deshabilita esta instancia (true = se despliega)
      "odoo_version": "19.0",                  # Version de Odoo (debe existir el Dockerfile correspondiente)
      "external_port": 8070,                     # Puerto en el host donde nginx escucha (debe ser unico)
      "database": "local_pg16",                  # Referencia a la base de datos (debe existir en la seccion databases)
      "odoo_config": "19.0_full",                # Referencia a la configuracion base (debe existir en odoo_configs)
      "overwrite_odoo_config": {
        "enabled": true,                         # Sobrescribe habilitacion de la instancia
        "admin_password": "admin",               # Sobrescribe password del admin
        "workers": 4,                              # Sobrescribe numero de workers (ej: 4 para produccion)
        "without_demo": true,                      # Sobrescribe sin datos demo
        "list_db": true,                           # Sobrescribe listar bases de datos
        "proxy_mode": true,                        # Sobrescribe modo proxy
        "limit_memory_soft": 32000000000,          # Memoria suave aumentada (32GB)
        "limit_memory_hard": 34000000000,          # Memoria hard aumentada (34GB)
        "max_cron_threads": 1,                     # Sobrescribe threads de cron
        "limit_time_real_cron": 0,                 # Sobrescribe limite de tiempo cron
        "limit_time_real": 3600,                   # Sobrescribe tiempo maximo de request
        "limit_time_cpu": 60,                      # Sobrescribe tiempo maximo de CPU
        "db_maxconn": 200,                         # Sobrescribe conexiones maximas
        "unaccent": false,                         # Sobrescribe sin unaccent
        "server_wide_modules": "",                 # Sobrescribe modulos server-wide
        "db_filter": "",                           # Sobrescribe filtro de bases de datos
        "db_name": "prod",                         # Sobrescribe nombre de base de datos por defecto
        "server_mode": "production",               # Sobrescribe modo del servidor
        "aeroo_docs_host": "aeroo",                # Sobrescribe host de Aeroo
        "custom_config": "[options]",              # Sobrescribe configuracion personalizada
        "addons": [                                # Sobrescribe lista de addons especificos
          "src/enterprise",
          "src/custom/client-a"
        ]
      }
    },
    "client-b": {
      "enabled": true,                         # Habilita o deshabilita esta instancia
      "odoo_version": "17.0",                  # Version de Odoo
      "external_port": 8071,                   # Puerto unico en el host para esta instancia
      "database": "external_pg16",             # Referencia a base de datos externa
      "odoo_config": "17.0_full",              # Configuracion base de Odoo
      "overwrite_odoo_config": {
        "enabled": true,                       # Sobrescribe habilitacion
        "admin_password": "admin",             # Sobrescribe password admin
        "workers": 2,                            # Workers por defecto
        "without_demo": true,                  # Sin datos demo
        "list_db": true,                       # Permite listar DBs
        "proxy_mode": true,                    # Modo proxy activo
        "limit_memory_soft": 16000000000,      # Memoria suave por defecto
        "limit_memory_hard": 17000000000,      # Memoria hard por defecto
        "max_cron_threads": 1,                   # Threads de cron
        "limit_time_real_cron": 0,             # Sin limite de tiempo cron
        "limit_time_real": 3600,               # Tiempo maximo request
        "limit_time_cpu": 60,                  # Tiempo maximo CPU
        "db_maxconn": 200,                     # Conexiones maximas
        "unaccent": false,                     # Sin unaccent
        "server_wide_modules": "",               # Modulos server-wide
        "db_filter": "",                         # Filtro de DBs
        "db_name": "False",                      # Base de datos por defecto deshabilitada
        "server_mode": "test",                   # Modo test
        "aeroo_docs_host": "aeroo",                # Host de Aeroo
        "custom_config": "[options]",            # Configuracion personalizada
        "addons": [                                # Addons especificos para este cliente
          "src/enterprise",
          "src/custom/client-b"
        ]
      }
    }
  },
  "pgadmin": {
    "enabled": false,                          # Habilita o deshabilita el servicio pgAdmin
    "port": 5050,                              # Puerto en el host para acceder a pgAdmin
    "email": "admin@admin.com",                # Email de inicio de sesion para pgAdmin
    "password": "admin"                        # Password de inicio de sesion para pgAdmin
  }
}
