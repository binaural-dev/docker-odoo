{
  "odoo_configs": {
    "19.0_full": {
      "enabled": true,                         // Habilita o deshabilita esta configuracion base
      "admin_password": "admin",               // Password del administrador de Odoo (acceso a /web/database/manager)
      "workers": 2,                            // Numero de workers Gunicorn para peticiones concurrentes
      "without_demo": true,                    // Evita datos demo al crear nuevas bases de datos
      "list_db": true,                         // Permite listar bases de datos en /web/database/manager
      "proxy_mode": true,                      // Activa modo proxy para funcionar detras de nginx
      "limit_memory_soft": 16000000000,        // Limite de memoria suave por worker en bytes (16GB)
      "limit_memory_hard": 17000000000,        // Limite de memoria hard por worker en bytes (17GB)
      "max_cron_threads": 1,                   // Threads dedicados a cron jobs
      "limit_time_real_cron": 0,               // Limite de tiempo para cron jobs (0 = sin limite)
      "limit_time_real": 3600,                 // Tiempo maximo de ejecucion para requests HTTP en segundos
      "limit_time_cpu": 60,                    // Tiempo maximo de CPU por request en segundos
      "db_maxconn": 200,                       // Conexiones maximas a PostgreSQL por worker
      "unaccent": false,                       // Extension unaccent de PostgreSQL para busquedas sin acentos
      "server_wide_modules": "",               // Modulos cargados en todos los workers (ej: "web,base_import_module")
      "db_filter": "",                         // Filtro regex para restringir bases de datos visibles
      "db_name": "False",                      // Base de datos por defecto ("False" para deshabilitar)
      "server_mode": "test",                   // Modo del servidor: "test", "development", "production"
      "aeroo_docs_host": "aeroo",              // Host del servicio Aeroo Docs para reportes
      "custom_config": "[options]",            // Configuracion Odoo personalizada inyectada en odoo.conf
      "addons": [                              // Rutas de directorios de addons adicionales (relativos a la raiz)
        "src/enterprise",
        "src/custom/modules"
      ]
    },
    "17.0_full": {
      "enabled": true,
      "admin_password": "admin",               // Password del administrador de Odoo
      "workers": 2,                            // Numero de workers Gunicorn
      "without_demo": true,                    // Evita datos demo
      "list_db": true,                         // Permite listar bases de datos
      "proxy_mode": true,                      // Modo proxy para nginx
      "limit_memory_soft": 16000000000,        // Limite de memoria suave (16GB)
      "limit_memory_hard": 17000000000,        // Limite de memoria hard (17GB)
      "max_cron_threads": 1,                   // Threads para cron jobs
      "limit_time_real_cron": 0,               // Limite de tiempo para cron jobs
      "limit_time_real": 3600,                 // Tiempo maximo de ejecucion para requests
      "limit_time_cpu": 60,                    // Tiempo maximo de CPU por request
      "db_maxconn": 200,                       // Conexiones maximas a PostgreSQL
      "unaccent": false,                       // Sin extension unaccent
      "server_wide_modules": "",               // Modulos server-wide
      "db_filter": "",                         // Filtro de bases de datos
      "db_name": "False",                      // Base de datos por defecto
      "server_mode": "test",                   // Modo del servidor
      "aeroo_docs_host": "aeroo",              // Host de Aeroo Docs
      "custom_config": "[options]",            // Configuracion personalizada inyectada
      "addons": [
        "src/enterprise",
        "src/custom/modules"
      ]
    }
  },
  "databases": {
    "v16": {
      "postgres_version": 15,                  // Version de PostgreSQL a usar
      "port": 5432,                            // Puerto en el host (solo se publica si expose_host_port: true)
      "expose_host_port": false,               // true para publicar el puerto al host (clientes de escritorio, etc.)
      "user": "odoo",                          // Usuario de PostgreSQL
      "password": "odoo",                      // Password de PostgreSQL
      "config": "postgresql.small.conf"        // Archivo de config en .resources/dbconfigs/
    },
    "v17": {
      "postgres_version": 16,
      "port": 5432,
      "expose_host_port": false,
      "user": "odoo",
      "password": "odoo",
      "config": "postgresql.xlarge.conf"
    },
    "v18": {
      "postgres_version": 17,
      "port": 5432,
      "expose_host_port": false,
      "user": "odoo",
      "password": "odoo",
      "config": "postgresql.small.conf"
    },
    "v19": {
      "postgres_version": 18,
      "port": 5432,
      "expose_host_port": false,
      "user": "odoo",
      "password": "odoo",
      "config": "postgresql.small.conf"
    }
  },
  "instances": {
    "client-a": {
      "enabled": true,                         // Habilita o deshabilita esta instancia
      "odoo_version": "19.0",                  // Version de Odoo
      "external_port": 8070,                   // Puerto en el host
      "database": "v19",                       // Referencia a la base de datos
      "odoo_config": "19.0_full",              // Referencia a la configuracion base
      "overwrite_odoo_config": {
        "addons": [
          "src/enterprise_v19",
          "src/custom/client-a"
        ],
        "db_filter": "^client-a_"
      }
    },
    "client-b": {
      "enabled": true,
      "odoo_version": "17.0",
      "external_port": 8071,
      "database": "v17",
      "odoo_config": "17.0_full",
      "overwrite_odoo_config": {
        "addons": [
          "src/enterprise_v17",
          "src/custom/client-b"
        ]
      }
    },
    "client-paused": {
      "enabled": false,                        // Instancia deshabilitada (no se despliega)
      "odoo_version": "19.0",
      "external_port": 8072,
      "database": "v19",
      "odoo_config": "19.0_full",
      "overwrite_odoo_config": {
        "addons": [
          "src/enterprise_v19",
          "src/custom/client-paused"
        ]
      }
    }
  },
  "pgadmin": {
    "enabled": false,                          // Habilita o deshabilita el servicio pgAdmin
    "port": 5050,                              // Puerto en el host para acceder a pgAdmin
    "email": "admin@admin.com",                // Email de inicio de sesion
    "password": "admin"                        // Password de inicio de sesion
  },
  "mailhog": {
    "enabled": true,                           // Habilita o deshabilita MailHog (captura emails salientes en dev)
    "smtp_port": 1025,                         // Puerto SMTP interno (lo que usa Odoo)
    "http_port": 8025                          // Puerto web UI expuesto en el host (http://localhost:8025)
  }
}
