{
  "odoo_configs": {
    "19.0_full": {
      "enabled": true,
      "admin_password": "admin",
      "workers": 2,
      "without_demo": true,
      "list_db": true,
      "proxy_mode": true,
      "limit_memory_soft": 16000000000,
      "limit_memory_hard": 17000000000,
      "max_cron_threads": 1,
      "limit_time_real_cron": 0,
      "limit_time_real": 3600,
      "limit_time_cpu": 60,
      "db_maxconn": 200,
      "unaccent": false,
      "server_wide_modules": "",
      "db_filter": "",
      "db_name": "False",
      "server_mode": "test",
      "aeroo_docs_host": "aeroo",
      "custom_config": "[options]",
      "addons": [
        "src/enterprise",
        "src/custom/modules"
      ]
    },
    "17.0_full": {
      "enabled": true,
      "admin_password": "admin",
      "workers": 2,
      "without_demo": true,
      "list_db": true,
      "proxy_mode": true,
      "limit_memory_soft": 16000000000,
      "limit_memory_hard": 17000000000,
      "max_cron_threads": 1,
      "limit_time_real_cron": 0,
      "limit_time_real": 3600,
      "limit_time_cpu": 60,
      "db_maxconn": 200,
      "unaccent": false,
      "server_wide_modules": "",
      "db_filter": "",
      "db_name": "False",
      "server_mode": "test",
      "aeroo_docs_host": "aeroo",
      "custom_config": "[options]",
      "addons": [
        "src/enterprise",
        "src/custom/modules"
      ]
    }
  },
  "databases": {
    "v16": {
      "postgres_version": 15,
      "port": 5432,
      "user": "odoo",
      "password": "odoo",
      "config": "postgresql.small.conf"
    },
    "v17": {
      "postgres_version": 16,
      "port": 5432,
      "user": "odoo",
      "password": "odoo",
      "config": "postgresql.xlarge.conf"
    },
    "v18": {
      "postgres_version": 17,
      "port": 5432,
      "user": "odoo",
      "password": "odoo",
      "config": "postgresql.small.conf"
    },
    "v19": {
      "postgres_version": 18,
      "port": 5432,
      "user": "odoo",
      "password": "odoo",
      "config": "postgresql.small.conf"
    }
  },
  "instances": {
    "client-a": {
      "enabled": true,
      "odoo_version": "19.0",
      "external_port": 8070,
      "database": "v19",
      "odoo_config": "19.0_full",
      "overwrite_odoo_config": {
        "addons": [
          "src/enterprise_v19",
          "src/custom/client-a"
        ],
        "db_filter": "^client-a_"
      }
    },
    "client-b": {
      "enabled": true,
      "odoo_version": "17.0",
      "external_port": 8071,
      "database": "v17",
      "odoo_config": "17.0_full",
      "overwrite_odoo_config": {
        "addons": [
          "src/enterprise_v17",
          "src/custom/client-b"
        ]
      }
    },
    "client-paused": {
      "enabled": false,
      "odoo_version": "19.0",
      "external_port": 8072,
      "database": "v19",
      "odoo_config": "19.0_full",
      "overwrite_odoo_config": {
        "addons": [
          "src/enterprise_v19",
          "src/custom/client-paused"
        ]
      }
    }
  },
  "pgadmin": {
    "enabled": false,
    "port": 5050,
    "email": "admin@admin.com",
    "password": "admin"
  }
