/* ============================================================
   docker-odoo TUI - Stylesheet
   Layout: Header / [Instances | Actions] / Progress* / Output / Footer
   ============================================================ */

Screen {
    background: $surface;
}

/* ----- Header / Footer ----- */
Header {
    dock: top;
}
Footer {
    dock: bottom;
}

/* ----- Main split: instances | actions ----- */
#main {
    height: 55%;
    margin: 0 1 1 1;
}
#left, #right {
    width: 1fr;
    border: round $primary;
    padding: 0 1;
    margin: 0;
}
#left {
    /* Ligeramente mas ancho para que entren nombres largos como
       'demo-integration-core' sin truncar. */
    width: 55%;
    margin-right: 1;
    border: round $primary;
}
#right {
    border: round $secondary;
}

/* ----- Subtitles (encabezado de cada panel) ----- */
Static#subtitle {
    color: $secondary;
    text-style: bold;
    padding: 0 2;
    height: 1;
    background: $boost;
}
Static#subtitle_meta {
    color: $text-muted;
    padding: 0 2;
    height: 1;
}

/* ----- ListViews ----- */
ListView {
    height: 1fr;
    padding: 0 0;
}
ListView > ListItem {
    padding: 0 1;
}
ListView > ListItem.--highlight {
    background: $accent;
    text-style: bold;
}
OptionList > Option.--highlight {
    background: $accent;
    text-style: bold;
}

/* ----- Category headers en la lista de acciones ----- */
ListView > ListItem.category_header {
    padding: 0 1;
    color: $secondary;
    text-style: bold;
    background: $boost;
}
ListView > ListItem.category_header.--highlight {
    background: $accent;
    color: $text;
}

/* ----- Output log (RichLog) ----- */
RichLog {
    height: 1fr;
    min-height: 5;
    border: round $primary;
    background: $surface-darken-1;
    margin: 0 1;
    padding: 0 1;
}

/* ----- Modal box ----- */
#modal_box {
    background: $panel;
    border: thick $accent;
    padding: 1 4;
    width: 70;
    min-width: 50;
    max-width: 100;
    height: auto;
    align: center middle;
}
#modal_box Label {
    width: 100%;
    content-align: center middle;
}
#modal_title {
    text-style: bold;
    color: $accent;
    padding-bottom: 1;
    height: 1;
}
#modal_subtitle {
    color: $text-muted;
    text-style: italic;
    padding-bottom: 1;
    height: auto;
}
#modal_message {
    padding: 1 0;
    color: $text;
    text-align: center;
}
#modal_fields {
    height: auto;
    padding: 1 0;
}
#modal_fields Input {
    margin-bottom: 1;
}
.field_label {
    color: $secondary;
    text-style: bold;
    padding: 0 1;
    height: 1;
}
.field_hint {
    color: $text-muted;
    text-style: italic;
    padding: 0 1;
    margin-bottom: 1;
    height: 1;
}
.field_required {
    color: $error;
    text-style: bold;
}
#modal_buttons {
    align-horizontal: center;
    height: 3;
    padding-top: 1;
}
#modal_buttons Button {
    margin: 0 2;
    min-width: 14;
}

/* ----- Picker modal (fzf-style) ----- */
#picker_panes {
    height: 1fr;
    margin: 1 0;
}
#picker_left, #picker_right {
    width: 1fr;
    border: round $primary;
    padding: 0 1;
    margin: 0 1;
}
#picker_left OptionList, #picker_right OptionList {
    height: 1fr;
    border: none;
}
#picker_hints {
    color: $secondary;
    padding: 0 1;
}
#picker_hints_row {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

/* ============================================================
   UpdateProgress widget
   ============================================================ */
#update_progress {
    display: none;
    border: round $success;
    background: $surface-darken-1;
    padding: 0 2;
    height: auto;
    min-height: 11;
    margin: 0 1 1 1;
}

#update_progress #up_title {
    text-style: bold;
    color: $success;
    padding: 0 1;
    height: 1;
}

#update_progress ProgressBar {
    width: 100%;
    margin: 0 1;
}

#update_progress #up_progress_label,
#update_progress #up_remaining {
    color: $text;
    padding: 0 1;
    height: 1;
}

#update_progress #up_progress_label {
    text-style: bold;
}

#update_progress #up_filters_row {
    height: 1;
    padding: 0 1;
    align: left middle;
}
#update_progress #up_filters_row Static {
    margin-right: 2;
}
#update_progress #up_filters_row Static.active {
    text-style: bold;
    color: $success;
}
#update_progress #up_filters_row Static.inactive {
    color: $text-muted;
}

#update_progress #up_hints_row {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}
#update_progress #up_hints_row Static {
    margin-right: 2;
}
