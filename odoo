def _get_studio_views_inheriting_from_modules(config, instance, dbname, modules):
    if not modules:
        return []
    mod_list = ", ".join(f"'{m}'" for m in modules)
    query = (
        "SELECT v.id, v.name, v.model, md.module "
        "FROM ir_ui_view v "
        "JOIN ir_ui_view parent ON v.inherit_id = parent.id "
        "JOIN ir_model_data md ON md.res_id = parent.id AND md.model = 'ir.ui.view' "
        "LEFT JOIN ir_model_data md_v ON md_v.res_id = v.id AND md_v.model = 'ir.ui.view' "
        f"WHERE (v.studio = true OR md_v.id IS NULL) "
        f"AND md.module IN ({mod_list}) AND v.active = true "
        "ORDER BY md.module, v.name"
    )
    output = _run_psql_query(config, instance, dbname, query)
    if not output:
        return []
    results = []
    for line in output.split("\n"):
        parts = line.split("|")
        if len(parts) >= 4:
            try:
                results.append({
                    "id": int(parts[0]),
                    "name": parts[1],
                    "model": parts[2],
                    "owner_module": parts[3],
                })
            except ValueError:
                pass
    return results


def _disable_studio_views(config, instance, dbname, views):
    if not views:
        return
    ids = ", ".join(str(v["id"]) for v in views)
    _run_psql_update(config, instance, dbname,
                     f"UPDATE ir_ui_view SET active = false WHERE id IN ({ids})")


