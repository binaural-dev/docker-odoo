def _fetch_database_ownership(db_container, user, password):
    """Lectura pura: lista cada base real (no template) de este servicio de
    Postgres con su dueño actual y si PUBLIC todavia puede conectarse. Usa
    el rol de servicio de siempre (el que ya usan los contenedores Odoo) --
    no hace falta break-glass ni el rol bootstrap, porque el nombre/dueño de
    cada base es metadata de catalogo, visible para cualquier rol logueable
    aunque no tenga CONNECT a esa base puntual."""
    result = subprocess.run(
        ["docker", "exec", "-e", f"PGPASSWORD={password}", db_container,
         "psql", "-U", user, "-d", "postgres", "-tAc",
         "SELECT d.datname, r.rolname, has_database_privilege('public', d.datname, 'CONNECT') "
         "FROM pg_database d JOIN pg_roles r ON r.oid = d.datdba WHERE NOT d.datistemplate;"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        return None
    rows = []
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        datname, owner, public_connect = line.split("|")
        rows.append({"datname": datname, "owner": owner, "public_connect": public_connect == "t"})
    return rows


def audit_db_filter_drift(config):
    """Compara, para cada servicio de Postgres compartido por >1 instancia,
    el 'db_filter' resuelto de cada instancia contra el ownership/CONNECT
    real en Postgres. Solo lee, nunca modifica nada -- devuelve una lista de
    hallazgos estructurados (dicts), no strings, para que el caller pueda
    tanto imprimirlos como decidir cuales son corregibles automaticamente
    con 'provision-role' (ver build_odoo()/_maybe_fix_drift()).

    Cada hallazgo trae 'category', 'instance' (o None si involucra a mas de
    una), 'message' (texto ya formateado para imprimir) y 'fixable' (si
    'provision-role' sobre 'instance' resuelve esto sin ambiguedad).

    Por que hace falta: 'provision-role' aplica el ownership/CONNECT una
    sola vez, cuando se corre a mano. Editar 'db_filter' en instances.json
    despues no re-dispara nada solo -- esta auditoria es lo que detecta que
    quedo desalineado, para poder avisar en cada './odoo build' en vez de
    descubrirlo por un incidente real (como ya paso una vez)."""
    by_service = defaultdict(list)
    for inst_name, inst_conf in config["instances"].items():
        by_service[inst_conf["database"]].append(inst_name)

    findings = []

    for db_name, inst_names in by_service.items():
        if len(inst_names) <= 1:
            continue  # una sola instancia en el servicio, sin riesgo de cruce

        db_conf = config["databases"][db_name]
        db_container = f"db-{db_name}"
        rows = _fetch_database_ownership(db_container, db_conf["user"], db_conf["password"])
        if rows is None:
            findings.append({
                "category": "unreachable", "instance": None, "fixable": False,
                "message": (
                    f"[{db_name}] no se pudo leer el estado real de Postgres "
                    f"para auditar (servicio caido o inalcanzable?) -- omitido"
                ),
            })
            continue

        matches_by_db = defaultdict(list)

        for inst_name in inst_names:
            inst_conf = config["instances"][inst_name]
            odoo_conf = resolve_instance_config(inst_conf, config)
            db_filter = odoo_conf.get("db_filter") or ""
            max_cron_threads = odoo_conf.get("max_cron_threads", 1)
            expected_user = inst_conf.get("db_user")

            if not db_filter or db_filter == "*" or "%h" in db_filter or "%d" in db_filter:
                continue  # ya lo reporta _validate_cron_dbfilter_isolation, no duplicar

            try:
                matched = [r for r in rows if re.match(db_filter, r["datname"])]
            except re.error:
                continue  # regex invalido -- tampoco duplicar aca

            for r in matched:
                matches_by_db[r["datname"]].append(inst_name)

                if expected_user and r["owner"] != expected_user:
                    findings.append({
                        "category": "owner_mismatch", "instance": inst_name, "fixable": True,
                        "message": (
                            f"[{inst_name}] '{r['datname']}' matchea su db_filter "
                            f"('{db_filter}') pero pertenece al rol '{r['owner']}', no a "
                            f"'{expected_user}' -- correr: ./odoo provision-role {inst_name}"
                        ),
                    })
                elif (expected_user and max_cron_threads != 0
                        and r["owner"] == expected_user and r["public_connect"]):
                    findings.append({
                        "category": "connect_open", "instance": inst_name, "fixable": True,
                        "message": (
                            f"[{inst_name}] '{r['datname']}' ya es del rol correcto pero "
                            f"PUBLIC todavia puede conectarse (CONNECT no revocado) -- "
                            f"correr: ./odoo provision-role {inst_name}"
                        ),
                    })

            if expected_user:
                for r in rows:
                    if r["owner"] == expected_user and not re.match(db_filter, r["datname"]):
                        findings.append({
                            "category": "filter_drift", "instance": inst_name, "fixable": False,
                            "message": (
                                f"[{inst_name}] '{r['datname']}' pertenece a su rol dedicado "
                                f"'{expected_user}' pero YA NO matchea su db_filter actual "
                                f"('{db_filter}') -- el filtro cambio despues de aprovisionar; "
                                f"revisar si es intencional (¿la base deberia pasar a otra "
                                f"instancia?) o si el filtro se edito por error -- NO se "
                                f"ofrece correccion automatica, requiere revision manual"
                            ),
                        })

        for datname, matched_insts in matches_by_db.items():
            if len(matched_insts) > 1:
                findings.append({
                    "category": "overlap", "instance": None, "fixable": False,
                    "message": (
                        f"[{db_name}] '{datname}' matchea el db_filter de mas de una "
                        f"instancia a la vez ({', '.join(matched_insts)}) -- los regex se "
                        f"solapan, revisarlos antes de aprovisionar (aprovisionar de mas "
                        f"puede robarle la base a la instancia que ya la tenia) -- NO se "
                        f"ofrece correccion automatica, requiere revision manual"
                    ),
                })

    return findings


def print_db_filter_audit(findings):
    """Muestra en consola el resultado de audit_db_filter_drift(). A
    diferencia de la validacion de config_loader (que corta la ejecucion),
    esto solo avisa -- nunca bloquea el build."""
    print("\n\033[1;94m=== 🔍 AUDITORÍA: db_filter vs ownership real en Postgres ===\033[0m\n")
    if not findings:
        print("✅ Sin diferencias -- el db_filter de cada instancia coincide con el ownership/CONNECT real.\n")
        return
    print(f"⚠️  {len(findings)} diferencia(s) encontrada(s):\n")
    for f in findings:
        print(f"  - {f['message']}")
    print()


def _provision_targets_grouped(config, instance_names):
    """Resuelve targets de aprovisionamiento y los agrupa por servicio de
    Postgres (db_container) -- mismo patron usado en la migracion batch
    original, para aplicar un solo break-glass por servicio en vez de uno
    por instancia."""
    targets = [_resolve_provision_target(config, name) for name in instance_names]
    groups = defaultdict(list)
    for t in targets:
        groups[t["db_container"]].append(t)
    return groups


def provision_instances_grouped(config, instance_names):
    """Aprovisiona varias instancias a la vez, agrupando por servicio de
    Postgres para minimizar ventanas de mantenimiento. Usado por el flujo
    interactivo de './odoo build' cuando se confirma corregir el drift
    detectado por la auditoria (ver _maybe_fix_drift())."""
    groups = _provision_targets_grouped(config, instance_names)
    for db_container, group in groups.items():
        bootstrap_user = group[0]["bootstrap_user"]
        bootstrap_password = group[0]["bootstrap_password"]
        db_conf = group[0]["db_conf"]
        db_name = group[0]["db_name"]

        print(f"\n--- Servicio {db_container}: {len(group)} instancia(s) ---")
        for t in group:
            print(f"  - {t['instance']} (rol {t['db_user']})")

        needs = _bootstrap_needs_breakglass(db_container, bootstrap_user, bootstrap_password)
        if needs:
            _bootstrap_breakglass_enable(db_container, bootstrap_user, db_conf, db_name)
        else:
            print(f"→ Bootstrap ya logueable, sin break-glass.")

        for t in group:
            print(f"\n--- {t['instance']} ---")
            provision_role_sql(t)

        _pg_exec(db_container, bootstrap_user, bootstrap_password, "postgres",
                 f"ALTER ROLE {bootstrap_user} NOLOGIN;")
        print(f"\n✅ Servicio {db_container} listo, bootstrap de nuevo en NOLOGIN.")


def _maybe_fix_drift(config, findings, no_confirm):
    """Si la auditoria encontro diferencias corregibles sin ambiguedad
    (dueño incorrecto, CONNECT sin revocar), ofrece corregirlas ahora
    mismo con 'provision-role', agrupando por servicio. Los hallazgos
    ambiguos (filtro que cambio, filtros solapados) nunca se auto-corrigen
    -- requieren revision humana antes de tocar ownership."""
    fixable_instances = sorted({
        f["instance"] for f in findings if f["fixable"] and f["instance"]
    })
    if not fixable_instances:
        return

    print(
        f"{len(fixable_instances)} instancia(s) con diferencias que "
        f"'provision-role' puede corregir automaticamente: "
        f"{', '.join(fixable_instances)}"
    )

    if no_confirm:
        print(
            "--no-confirm: se omite la correccion automatica -- correr "
            "'./odoo provision-role <instancia>' a mano si hace falta.\n"
        )
        return

    try:
        answer = input("¿Correr 'provision-role' para todas ellas ahora? [y/N]: ").strip().lower()
    except EOFError:
        print(
            "\n(sin entrada interactiva -- se omite la correccion automatica; "
            "correr './odoo provision-role <instancia>' a mano)\n"
        )
        return

    if answer != "y":
        print("Se omite la correccion automatica.\n")
        return

    provision_instances_grouped(config, fixable_instances)


def build_odoo(config, no_cache, no_confirm=False):
    """Generate all config files and build Docker images."""
    print("\n\033[1;94m=== 🛠️  GENERANDO CONFIGURACIONES Y CONSTRUYENDO IMÁGENES ===\033[0m\n")

    # 1. Generate Dockerfiles for each unique Odoo version
    unique_versions = get_unique_odoo_versions(config)
    print(f"Versiones de Odoo detectadas: {', '.join(sorted(unique_versions))}")
    dockerfile_map = generate_dockerfiles(BASE_PATH, unique_versions)

    # 2. Generate docker-compose.generated.yml
    generate_compose(BASE_PATH, config, dockerfile_map)

    # 3. Generate nginx config
    generate_nginx_config(BASE_PATH, config)

    # 3.5 Auditar db_filter vs ownership real -- avisa, y ofrece corregir
    #     automaticamente lo que no es ambiguo (ver _maybe_fix_drift)
    findings = audit_db_filter_drift(config)
    print_db_filter_audit(findings)
    _maybe_fix_drift(config, findings, no_confirm)

    # 4. Build images
    print("\n=== Construyendo imágenes Docker ===\n")
    if no_cache:
        _docker_compose("build", "--no-cache")
    else:
        _docker_compose("build")

    print("\n✅ Build completado.\n")


def start_odoo(config, instance=None):
    """Start database(s), Odoo instance(s), and nginx."""
    if instance:
        print(f"\n\033[1;32m=== ▶️  INICIANDO INSTANCIA: {instance.upper()} ===\033[0m\n")
    else:
        print("\n\033[1;32m=== ▶️  INICIANDO TODAS LAS INSTANCIAS ===\033[0m\n")

    db_services = _get_db_services(config, instance)
    odoo_services = _get_instance_services(config, instance)

    # Start managed DBs
    if db_services:
        print("→ Iniciando base(s) de datos...")
        _docker_compose("up", "-d", *db_services)

    # Start Odoo instances
    print("\n→ Iniciando instancia(s) Odoo...")
    _docker_compose("up", "-d", *odoo_services)

    # Fix filestore permissions
    for svc in odoo_services:
        os.system(
            f"docker exec -u root {svc} chown -R odoo:odoo /home/odoo/data 2>/dev/null || true"
        )

    # Start nginx
    print("\n→ Iniciando Nginx...")
    _docker_compose("up", "-d", "nginx")

    # Show URLs
    print("\n✅ Instancias en ejecución:\n")
    instances_to_show = [instance] if instance else config["instances"].keys()
    for name in instances_to_show:
        port = config["instances"][name]["external_port"]
        print(f"  • {name}: http://localhost:{port}")

    print()


def stop_odoo(config, instance=None):
    """Stop Odoo instance(s) and optionally their databases."""
    if instance:
        print(f"\n\033[1;33m=== ⏹️  DETENIENDO INSTANCIA: {instance.upper()} ===\033[0m\n")
        odoo_services = _get_instance_services(config, instance)
        _docker_compose("stop", *odoo_services)
        # Check if the DB is still used by other running instances
        db_name = config["instances"][instance]["database"]
        db_conf = config["databases"][db_name]
        if db_conf.get("create_container", True):
            other_users = [
                name for name, conf in config["instances"].items()
                if conf["database"] == db_name and name != instance
            ]
            if not other_users:
                print(f"\n→ Deteniendo base de datos {db_name} (sin otras instancias que la usen)...")
                _docker_compose("stop", f"db-{db_name}")
            else:
                print(f"\n→ Base de datos {db_name} no se detiene (usada por: {', '.join(other_users)})")
    else:
        print("\n\033[1;33m=== ⏹️  DETENIENDO TODAS LAS INSTANCIAS ===\033[0m\n")
        _docker_compose("down")

    print("\n🛑 Detenido.\n")


def restart_odoo(config, instance=None):
    """Restart Odoo instance(s)."""
    if instance:
        print(f"\n\033[1;36m=== 🔄 REINICIANDO INSTANCIA: {instance.upper()} ===\033[0m\n")
    else:
        print("\n\033[1;36m=== 🔄 REINICIANDO TODAS LAS INSTANCIAS ===\033[0m\n")
    stop_odoo(config, instance)
    start_odoo(config, instance)


def remove_odoo(config, instance=None):
    """Remove containers and volumes."""
    if instance:
        target = f"instancia '\033[91m{instance}\033[0m'"
    else:
        target = "\033[91mTODAS\033[0m las instancias y bases de datos"

    print(f"\n⚠️  \033[1mPELIGRO\033[0m: Esto eliminará {target} y sus volúmenes de datos.")
    do_continue = input("¿Estás seguro de que deseas continuar? (s/N): ")
    if do_continue.lower() != "s":
        print("\nOperación cancelada.")
        return

    if instance:
        odoo_services = _get_instance_services(config, instance)
        for svc in odoo_services:
            os.system(f"docker compose -f {COMPOSE_FILE} rm -s -v -f {svc}")
    else:
        _docker_compose("down", "-v", "--remove-orphans")

    print("\n🛑 Eliminado.\n")


def run_bash(config, instance):
    """Open bash in an Odoo instance container."""
    container = f"odoo-{instance}"
    # Check if container is running
    is_running = os.popen(f"docker inspect -f '{{{{.State.Running}}}}' {container} 2>/dev/null").read().strip()
    
    if is_running != "true":
        print(f"\n❌ El contenedor '{container}' no está en ejecución.")
        print(f"Prueba iniciando la instancia con: ./odoo start {instance}")
        return

    print(f"\n\033[1;34m=== 🐚 ABRIENDO BASH EN: {instance.upper()} ===\033[0m\n")
    os.system(f"docker exec -u root -it {container} bash")


def bash_update_modules(config, instance, dbname, modules="all", force_all=False):
    """Update Odoo modules in an instance.

    When updating "all" modules, this uses click-odoo-update by default --
    it only touches addons whose file hash changed since the last update,
    instead of literally reprocessing every installed module (which is what
    `odoo -u all` always does, regardless of whether anything changed).
    Pass force_all=True (the -f/--force CLI flag) to force a complete
    upgrade via click-odoo-update's own --update-all flag. Updating one
    specific module by name is unaffected -- that's already a deliberate,
    targeted operation, so it always goes straight through `odoo -u <modulo>`.
    """
    print(f"\n\033[1;35m=== 🆙 ACTUALIZANDO MÓDULOS EN: {instance.upper()} (DB: {dbname}) ===\033[0m\n")
    container = f"odoo-{instance}"
    if modules == "all":
        force_flag = " --update-all" if force_all else ""
        cmd = f"docker exec -u root -it {container} click-odoo-update --if-exists{force_flag} -d {dbname}"
    else:
        cmd = f"docker exec -u root -it {container} odoo --stop-after-init -p 90 --workers=0 -u {modules} -d {dbname}"
    print(cmd)
    return os.system(cmd)


