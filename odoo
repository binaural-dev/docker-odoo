                print(f"  {bmod:38s}  \033[93m⬜ Pendiente (instalar l10n_ve_{suffix} primero)\033[0m{must}")

            for bmod in m["forced_uninstall"]:
                print(f"  {bmod:38s}  \033[91m🔴 DEBE desinstalarse (sin equivalente l10n_ve_)\033[0m")

            print(f"\n\033[36m  Comando para desinstalar (cuando todos los l10n_ve_ estén instalados):\033[0m")
