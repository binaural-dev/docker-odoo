        choices=["status", "show", "apply", "dry-run"],
        help="status (default) | show | apply | dry-run",
    )

    # coverage-status / coverage — sólo aparecen acá para que se listen en
    # --help; main() intercepta estos dos verbos ANTES de parsear (ver más
    # abajo) y reenvía sys.argv tal cual a los scripts reales. Un
    # subparser con nargs=REMAINDER no reenvía bien flags como primer
    # argumento (p.ej. "--json"), así que evitamos ese camino.
    subparsers.add_parser(
        "coverage-status",
        help="Escaneo rápido (sin Docker) de qué clientes tienen módulos con tests/",
        description=(
            "Recorre src/custom/*/ buscando __manifest__.py + carpeta tests/ "
            "(sin contar submódulos compartidos). No usa Docker, es gratis y "
            "rápido. Para cada cliente con tests, imprime el comando exacto "
            "de 'coverage-run-all' para medir el % real.\n\n"
            "Flags útiles: --json, --pull, --only-with-tests, --help "
            "(ver 'scripts/coverage-status --help' para el detalle)."
        ),
    )
    subparsers.add_parser(
        "coverage",
        help="Corre coverage.py real para una, varias o todas las instancias con tests",
        description=(
            "Automatiza el ciclo completo por instancia: activa 'enabled' "
            "temporalmente si está en false, regenera el compose, buildea "
            "SOLO esa imagen, levanta el contenedor, espera a que Odoo y la "
            "DB estén listos, corre coverage.py real, para el contenedor, "
            "borra la imagen si la creó él mismo, y restaura 'enabled'. "
            "Sin argumentos corre sobre todos los clientes con tests.\n\n"
            "Ejemplos: './odoo coverage' (todos) | './odoo coverage contiflex' "
            "(uno) | './odoo coverage contiflex --dry-run' (solo mostrar el plan).\n"
