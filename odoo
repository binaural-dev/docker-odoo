    p.add_argument("branch", nargs="?", default=None, help="Rama del repositorio")
    p.add_argument("version", nargs="?", default=None, help="Versión de Odoo")

    # tui — thin entry point that hands off to the Textual app
    subparsers.add_parser(
        "tui", help="Abre el launcher interactivo (Textual)",
    )

    return parser


# ============================================================
# Main
# ============================================================


def main() -> int:
    """CLI entry point. Returns the process exit code."""
    os.chdir(BASE_PATH)

    # coverage / coverage-status: reenvía todo tal cual a los scripts reales,
    # sin pasar por argparse (ver el comentario en _build_parser).
    if len(sys.argv) > 1 and sys.argv[1] in ("coverage", "coverage-status"):
        script = "coverage-run-all" if sys.argv[1] == "coverage" else "coverage-status"
        return subprocess.run(
            [os.path.join(BASE_PATH, "scripts", script), *sys.argv[2:]]
        ).returncode

    parser = _build_parser()
    args = parser.parse_args()

    if not args.action:
        parser.print_help()
        return 0

    if args.action == "test":
        # "instance"/"module" son posicionales; -i/-m son la forma alternativa
        # con flag. La flag gana si se pasaron ambas formas.
        args.instance = args.instance_flag or args.instance
        args.module = args.module_flag or args.module

    runner = CliRunner()

    # The dispatch tree loads the config (which exits if instances.json
    # is missing) and validates it (which exits on duplicate ports /
    # missing databases). Both are runner-aware: errors go through
    # ``runner.error``.
    config = load_config(BASE_PATH)
    validate_instances(runner, config)

    return dispatch(runner, args, config, BASE_PATH)


if __name__ == "__main__":
    sys.exit(main())
