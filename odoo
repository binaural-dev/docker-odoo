def has_odoo_venezuela(config, instance):
    """Check if an instance has odoo-venezuela in its addons paths."""
    addons = _get_instance_addons_paths(config, instance)
    for path in addons:
        normalized = path.rstrip("/")
        if normalized.endswith("odoo-venezuela") or normalized.endswith("odoo-venezuela/"):
            return True
    return False


def get_available_l10n_ve_modules(config, instance):
    """Get available l10n_ve_ modules.
    
    Primero busca en los addons de la instancia. Si no encuentra,
    busca en src/custom/odoo-venezuela/ como referencia central.
    Retorna (modules, source) donde source indica de dónde se obtuvieron.
    """
    # 1. Buscar en los addons de la instancia
    addons = _get_instance_addons_paths(config, instance)
    for path in addons:
        normalized = path.rstrip("/")
        if normalized.endswith("odoo-venezuela"):
            full_path = os.path.join(BASE_PATH, normalized)
            if os.path.isdir(full_path):
                modules = _scan_l10n_ve_dir(full_path)
                if modules:
                    return modules, "propia"

    # 2. Fallback: buscar en src/custom/odoo-venezuela/ (referencia central)
    central_ve = os.path.join(BASE_PATH, "src", "custom", "odoo-venezuela")
    if os.path.isdir(central_ve):
        modules = _scan_l10n_ve_dir(central_ve)
        if modules:
            return modules, "src/custom/odoo-venezuela"

    return [], None


def _scan_l10n_ve_dir(dirpath):
    """Scan a directory for l10n_ve_ Odoo modules."""
    modules = []
    for item in sorted(os.listdir(dirpath)):
        item_path = os.path.join(dirpath, item)
        if os.path.isdir(item_path) and item.startswith("l10n_ve_"):
            if os.path.exists(os.path.join(item_path, "__manifest__.py")) or \
               os.path.exists(os.path.join(item_path, "__openerp__.py")):
                modules.append(item)
    return modules


def get_custom_modules(config, instance, dbname=None):
    """List custom modules found in the addons paths of an instance.
    If dbname is provided, only returns modules installed in that database."""
    try:
        inst_conf = config["instances"][instance]
        odoo_conf = resolve_instance_config(inst_conf, config)
        addons_paths = odoo_conf.get("addons", [])
        
        disk_modules = []
        for path in addons_paths:
            full_path = os.path.join(BASE_PATH, path)
            if not os.path.isdir(full_path):
                continue
            for item in os.listdir(full_path):
                item_path = os.path.join(full_path, item)
                if os.path.isdir(item_path):
                    if os.path.exists(os.path.join(item_path, "__manifest__.py")) or \
                       os.path.exists(os.path.join(item_path, "__openerp__.py")):
                        disk_modules.append(item)
        disk_modules = sorted(list(set(disk_modules)))

        if dbname:
            installed = _get_installed_modules(config, instance, dbname)
            return [m for m in disk_modules if m in installed]

        return disk_modules
    except Exception:
        pass
    return []


