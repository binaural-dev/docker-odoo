    build_p.add_argument(
        "--no-confirm", action="store_true",
        help="No preguntar interactivamente si corregir el drift de db_filter detectado (uso en automatizacion/CI)",
    )

    # start
    start_p = subparsers.add_parser("start", help="Inicia instancia(s) de Odoo")
    start_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional, sin argumento inicia todas)")

    # stop
    stop_p = subparsers.add_parser("stop", help="Detiene instancia(s) de Odoo")
    stop_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")

    # restart
    restart_p = subparsers.add_parser("restart", help="Reinicia instancia(s) de Odoo")
    restart_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")

    # bash
    bash_p = subparsers.add_parser("bash", help="Abre bash en un contenedor Odoo")
    bash_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")

    # logs
    logs_p = subparsers.add_parser("logs", help="Muestra logs en tiempo real")
    logs_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")

    # list
    subparsers.add_parser("list", help="Lista contenedores en ejecución")

    # remove
    remove_p = subparsers.add_parser("remove", help="Elimina contenedores y volúmenes")
    remove_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")

    # fix-files
    fix_p = subparsers.add_parser("fix-files", help="Corrige permisos del filestore")
    fix_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")

    # psql
    psql_p = subparsers.add_parser("psql", help="Conectar a PostgreSQL")
    psql_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")
    psql_p.add_argument("-d", required=False, help="Nombre de la base de datos (opcional)")

    # pw
    pw_p = subparsers.add_parser("pw", help="Restablecer contraseña de un usuario")
    pw_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")
    pw_p.add_argument("-d", required=False, help="Nombre de la base de datos (opcional)")

    # provision-role
    provision_p = subparsers.add_parser(
        "provision-role",
        help="Crea/actualiza el rol dedicado de Postgres de una instancia y aisla sus bases (owner + REVOKE CONNECT)",
    )
    provision_p.add_argument("instance", help="Nombre de instancia (requiere db_user/db_password en instances.json)")
    pw_p.add_argument("-l", help="Login a restablecer (opcional)")
    pw_p.add_argument("-p", "--password", default="admin", help="Nueva contraseña (por defecto: admin)")

    # update
    update_p = subparsers.add_parser("update", help="Actualizar módulos de Odoo")
    update_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")
    update_p.add_argument("-d", required=False, help="Nombre de la base de datos o 'all' (opcional)")
    update_p.add_argument("-m", default=None, help="Módulos a actualizar (opcional)")
    update_p.add_argument(
        "-f", "--force", action="store_true",
        help="Forzar actualizacion literal de TODOS los modulos (sin esto, se usa click-odoo-update para actualizar solo lo que cambio)",
    )

    # init
    init_p = subparsers.add_parser("init", help="Inicializar addons/repositorios")
    init_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")

    # sync
    sync_p = subparsers.add_parser("sync", help="Sincroniza submódulos de un repositorio")
    sync_p.add_argument("r", nargs="?", default=None, help="Repositorio (opcional)")
    sync_p.add_argument("b", nargs="?", default=None, help="Branch (opcional)")
    sync_p.add_argument("--v", action="store_true", default=False, help="Mostrar salida de git")

    # test
    test_p = subparsers.add_parser(
        "test",
        help="Ejecuta tests de uno o varios módulos con cobertura",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Ejemplos:\n"
            "  ./odoo test integra-17 binaural_brand\n"
            "  ./odoo test integra-17 binaural_brand,binaural_mobile   # varios modulos\n"
            "  ./odoo test -i integra-17 -m binaural_brand             # con flags\n"
            "  ./odoo test integra-17 binaural_brand --recursive\n"
            "  ./odoo test integra-17 binaural_brand --out-coverage-json ./reportes\n"
            "  ./odoo test integra-17 binaural_brand --out-json ./reportes\n"
            "  ./odoo test integra-17 binaural_brand --all-verbose     "
            "# guarda todo en ./logs/\n"
            "  ./odoo test                                             "
            "# elige instancia y modulo(s) interactivamente\n"
        ),
    )
    test_p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional, se elige interactivamente). Alternativa: -i/--instance."
    )
    test_p.add_argument(
        "module", nargs="?", default=None,
        help="Modulo(s) a testear, separados por coma (opcional, se elige "
             "interactivamente). Alternativa: -m/--modules."
    )
    test_p.add_argument(
        "-i", "--instance", dest="instance_flag", default=None, metavar="INSTANCIA",
        help="Instancia (alternativa al posicional)."
    )
    test_p.add_argument(
        "-m", "--modules", dest="module_flag", default=None, metavar="MODULOS",
        help="Modulo(s), separados por coma (alternativa al posicional)."
    )
    test_p.add_argument("-d", "--db", default=None, help="Nombre de la base de datos (opcional)")
    test_p.add_argument("--tags", default="all", help="Ver ./scripts/odoo-test -h")
    test_p.add_argument("--recursive", action="store_true", help="Calcula el arbol completo de dependencias")
    test_p.add_argument("--exclude", default="", help="Modulos a omitir del arbol (con --recursive)")
    test_p.add_argument("--no-rm-db", action="store_true", help="No borra la base de datos al terminar")
    test_p.add_argument("--dry-run", action="store_true", help="Solo muestra el comando sin ejecutarlo")
    test_p.add_argument(
        "--out-coverage-json", default=None, metavar="RUTA",
        help="Exporta el reporte de cobertura en JSON. Si RUTA es un directorio "
             "se guarda como coverage.json dentro; si no, RUTA es el nombre de "
             "archivo completo (ej: ./mi_reporte.json)."
    )
    test_p.add_argument(
        "--out-json", default=None, metavar="RUTA",
        help="Exporta el resultado exacto de los tests (por test, separado en "
             "at_install/post_install) en JSON. Mismo criterio de RUTA que "
             "--out-coverage-json."
    )
    test_p.add_argument(
        "--out-logs", default=None, metavar="RUTA",
        help="Guarda en RUTA la salida completa de la corrida (boot, "
             "instalacion de modulos, tests, coverage). Mismo criterio de "
             "RUTA que --out-coverage-json."
    )
    test_p.add_argument(
        "--out-verbose", action="store_true",
        help="Muestra ademas el detalle por test (fase, resultado, tiempo, queries)."
    )
    test_p.add_argument(
        "--all-verbose", action="store_true",
        help="Atajo: activa --out-verbose y, para --out-json/--out-coverage-json/"
             "--out-logs que no se hayan indicado explicitamente, los apunta a "
             "./logs/ (se crea si no existe) con el nombre por defecto de cada "
             "uno (test_report.json, coverage.json, test_run.log)."
    )

    # apk
    apk_p = subparsers.add_parser(
        "apk",
        help="Genera el APK/AAB de la app (TWA) en un contenedor (toolchain en .resources/apk)",
        add_help=False,
    )
    apk_p.add_argument(
        "-h", "--help", action="store_true",
        help="Muestra la ayuda completa de scripts/odoo-apk",
    )
    apk_p.add_argument(
        "args", nargs=argparse.REMAINDER,
        help="Argumentos para scripts/odoo-apk (ver ./odoo apk --help)",
    )

    args = parser.parse_args()

    if not args.action:
        parser.print_help()
        return

    if args.action == "test":
        args.instance = args.instance_flag or args.instance
        args.module = args.module_flag or args.module

    # Load config for all commands
    config = load_config(BASE_PATH)

    actions_with_instance = {
        "start", "stop", "restart", "logs", "remove",
        "fix-files", "init", "bash", "psql", "pw", "update", "test"
    }
    
    if args.action in actions_with_instance and getattr(args, "instance", None) is None:
        args.instance = prompt_for_instance(config, args.action)

    # Dispatch
    if args.action == "build":
        build_odoo(config, args.no_cache, args.no_confirm)
    elif args.action == "start":
        start_odoo(config, args.instance)
    elif args.action == "stop":
        stop_odoo(config, args.instance)
    elif args.action == "restart":
        restart_odoo(config, args.instance)
    elif args.action == "bash":
        run_bash(config, args.instance)
    elif args.action == "logs":
        show_logs(config, args.instance)
    elif args.action == "list":
        list_containers(config)
    elif args.action == "remove":
        remove_odoo(config, args.instance)
    elif args.action == "fix-files":
        fix_filestore(config, args.instance)
    elif args.action == "psql":
        if args.d is None:
            args.d = prompt_for_database(config, args.instance)
        psql_connect(config, args.instance, args.d)
    elif args.action == "pw":
        if args.d is None:
            args.d = prompt_for_database(config, args.instance)
        if args.l is None:
            args.l = prompt_for_user(config, args.instance, args.d)
        reset_password(config, args.instance, args.d, args.l, args.password)
    elif args.action == "provision-role":
        provision_instance_role(config, args.instance)
    elif args.action == "update":
        if args.instance is None:
            args.instance = prompt_for_instance(config, "update")
        if args.d is None:
            args.d = prompt_for_database(config, args.instance, allow_all=True)
        if args.m is None:
            # Sin -m, actualizar todo directo -- no tiene sentido forzar al
            # usuario a elegir de una lista cuando "todos" ya es la opcion
            # por defecto sensata (y ahora, con click-odoo-update, la rapida).
            args.m = "all"
        if args.d.strip().lower() == "all":
            databases = get_databases(config, args.instance)
            if not databases:
                print("No se encontraron bases de datos para actualizar.")
                sys.exit(1)

            failures = []
            for db_name in databases:
                result = bash_update_modules(config, args.instance, db_name, args.m, force_all=args.force)
                if result != 0:
                    failures.append((db_name, result))

            if failures:
                print("\n❌ Algunas bases fallaron durante la actualización:")
                for db_name, code in failures:
                    print(f"  - {db_name} (exit code: {code})")
                sys.exit(1)
        else:
            bash_update_modules(config, args.instance, args.d, args.m, force_all=args.force)
    elif args.action == "init":
        init_addons(config, args.instance)
    elif args.action == "sync":
        if args.r is None:
            args.r = prompt_for_repos()
        if args.b is None:
            args.b = prompt_for_branch(args.r if isinstance(args.r, str) else None)
        sync(args.r, args.b, show=args.v)
    elif args.action == "apk":
        # scripts/odoo-apk es standalone (usa click, no lee instances.json):
        # se pasan sus argumentos tal cual, sin duplicar sus options en argparse.
        apk_args = list(args.args)
        if getattr(args, "help", False):
            apk_args.insert(0, "--help")
        cmd = [str(Path(BASE_PATH) / "scripts" / "odoo-apk")] + apk_args
        result = subprocess.run(cmd)
        sys.exit(result.returncode)
    elif args.action == "test":
        if args.module is None:
            args.module = prompt_for_test_modules(config, args.instance)

        container = f"odoo-{args.instance}"
        container_addons = resolve_container_addon_paths(config, args.instance)
        if not container_addons:
            print(f"Error: no se encontraron directorios de addons para la instancia '{args.instance}'.")
            sys.exit(1)

        if args.all_verbose:
            logs_dir = os.path.join(BASE_PATH, "logs")
            os.makedirs(logs_dir, exist_ok=True)
            args.out_json = args.out_json or logs_dir
            args.out_coverage_json = args.out_coverage_json or logs_dir
            args.out_logs = args.out_logs or logs_dir
            args.out_verbose = True
            print(f"--all-verbose: guardando reportes en {logs_dir}/")

        # scripts/odoo-test es standalone (no lee instances.json): este
        # comando es el unico punto acoplado a docker-odoo-multi, y le pasa
        # todo lo que necesita por flag (--container, --addons).
        cmd = [
            str(Path(BASE_PATH) / "scripts" / "odoo-test"),
            args.module,
            "--container", container,
            "--addons", ",".join(container_addons),
        ]
        if args.db:
            cmd += ["-d", args.db]
        if args.tags != "all":
            cmd += ["--tags", args.tags]
        if args.recursive:
            cmd.append("--recursive")
        if args.exclude:
            cmd += ["--exclude", args.exclude]
        if args.no_rm_db:
            cmd.append("--no-rm-db")
        if args.out_coverage_json:
            cmd += ["--out-coverage-json", args.out_coverage_json]
        if args.out_json:
            cmd += ["--out-json", args.out_json]
        if args.out_logs:
            cmd += ["--out-logs", args.out_logs]
        if args.out_verbose:
            cmd.append("--out-verbose")
        if args.dry_run:
            cmd.append("--dry-run")
        result = subprocess.run(cmd)
        sys.exit(result.returncode)


if __name__ == "__main__":
    main()
