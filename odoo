def _run_odoo_module_op(config, instance, dbname, modules, operation="update"):
    container = f"odoo-{instance}"
    if operation == "uninstall":
        mod_list = ", ".join(f"'{m}'" for m in modules)
        _run_psql_update(config, instance, dbname,
                         f"UPDATE ir_module_module SET state = 'to remove' WHERE name IN ({mod_list})")
        print(f"  ✅ {len(modules)} módulo(s) marcado(s) para desinstalar.")
        cmd = (
            f"docker exec -u root -it {container} odoo "
            f"--stop-after-init -p 90 --workers=0 -d {dbname}"
        )
        print(f"  \033[90m{cmd}\033[0m\n")
        ret = os.system(cmd)
        exit_code = os.WEXITSTATUS(ret) if os.name != 'nt' else ret
        if exit_code != 0:
            print(f"\n\033[1;31m  ❌ ERROR: La desinstalación falló con código {exit_code}.\033[0m")
            print(f"     Revisa los logs: \033[90m./odoo logs {instance}\033[0m")
            return False
        print(f"\n\033[92m  ✅ Desinstalación completada.\033[0m")
        print(f"\n  \033[1;36m🔄 Actualizando todos los módulos...\033[0m")
        cmd2 = (
            f"docker exec -u root -it {container} odoo "
            f"--stop-after-init -p 90 --workers=0 -u all -d {dbname}"
        )
        print(f"  \033[90m{cmd2}\033[0m\n")
        ret2 = os.system(cmd2)
        exit_code2 = os.WEXITSTATUS(ret2) if os.name != 'nt' else ret2
        if exit_code2 != 0:
            print(f"\n\033[1;31m  ❌ ERROR: La actualización falló con código {exit_code2}.\033[0m")
            print(f"     Revisa los logs: \033[90m./odoo logs {instance}\033[0m")
            return False
        print(f"\n\033[92m  ✅ Actualización completada correctamente.\033[0m")
        return True
    elif operation == "install":
        cmd = (
            f"docker exec -u root -it {container} odoo "
            f"--stop-after-init -p 90 --workers=0 "
            f"-i {','.join(modules)} -d {dbname}"
        )
    else:
        cmd = (
            f"docker exec -u root -it {container} odoo "
            f"--stop-after-init -p 90 --workers=0 "
            f"-u {','.join(modules)} -d {dbname}"
        )
    print(f"  \033[90m{cmd}\033[0m\n")
    ret = os.system(cmd)
    exit_code = os.WEXITSTATUS(ret) if os.name != 'nt' else ret
    if exit_code != 0:
        print(f"\n\033[1;31m  ❌ ERROR: La operación falló con código {exit_code}.\033[0m")
        print(f"     Revisa los logs: \033[90m./odoo logs {instance}\033[0m")
        return False
    print(f"\n\033[92m  ✅ Operación completada correctamente.\033[0m")
    return True


def prompt_selection(options, title, multi=False):
    """
    Generic interactive selection menu.
    options: list of (label, value) tuples.
    title: string to display.
    multi: boolean, if true allows multiple selection.
    returns: selected value (or list of values if multi).
    """
    if not options:
        return [] if multi else None

    def fallback_prompt():
        print(f"\n{title}:")
        for i, (text, _) in enumerate(options, 1):
            print(f"  {i}. {text}")
        if multi:
            print("  (Ingresa números separados por coma, ej: 1,3,4 o 'all' para todos)")
        while True:
            try:
                choice = input("\nSelección: ").strip().lower()
                if not choice:
                    if multi: return []
                    continue
                if multi and choice == 'all':
                    return [val for _, val in options]
                if multi:
                    indices = [int(x.strip()) for x in choice.replace(',', ' ').split() if x.strip()]
                    selected = []
                    for idx in indices:
                        if 1 <= idx <= len(options):
                            selected.append(options[idx-1][1])
                    return selected
                else:
                    idx = int(choice)
                    if 1 <= idx <= len(options):
                        return options[idx-1][1]
                print("Selección inválida.")
            except ValueError:
                print("Por favor ingresa un valor válido.")
            except (KeyboardInterrupt, EOFError):
                print("\nOperación cancelada.")
                sys.exit(0)

    if not sys.stdin.isatty():
        return fallback_prompt()

    try:
        import tty
        import termios
    except ImportError:
        return fallback_prompt()

    def getch():
        fd = sys.stdin.fileno()
        try:
            old_settings = termios.tcgetattr(fd)
        except Exception:
            return sys.stdin.read(1)
        try:
            tty.setraw(fd)
            ch = sys.stdin.read(1)
            if ch == '\x1b':
                ch += sys.stdin.read(2)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        return ch

    current_idx = 0
    selected_indices = set()
    input_buffer = ""

    # Grid settings
    try:
        term_width = os.get_terminal_size().columns
    except Exception:
        term_width = 80

    max_text_len = max(len(text) for text, _ in options)
    item_width = max_text_len + 10 # prefix + num + text + spacing
    num_cols = max(1, term_width // item_width)
    num_rows = (len(options) + num_cols - 1) // num_cols
    lines_to_clear = num_rows + 1

    print(f"\n{title}:")

    def render_menu():
        sys.stdout.write("\r")
        for row in range(num_rows):
            line_content = ""
            for col in range(num_cols):
                idx = row + col * num_rows
                if idx < len(options):
                    text, _ = options[idx]
                    num = f"{idx+1:2d}. "
                    prefix = "❯ " if idx == current_idx else "  "
                    if multi:
                        mark = "[x] " if idx in selected_indices else "[ ] "
                        prefix += mark

                    item = f"{prefix}{num}{text}"
                    # Padding to maintain columns
                    padding = " " * (item_width - len(item))

                    if idx == current_idx:
                        line_content += f"\033[92m{item}\033[0m{padding}"
                    else:
                        line_content += f"{item}{padding}"

            sys.stdout.write(f"{line_content}\033[K\n")

        if multi:
            sys.stdout.write(f"\033[90m(Espacio: sel, Enter: ok, A: todos, N: ninguno)\033[0m\033[K")
        else:
            sys.stdout.write(f"Opción (Número o flechas) [ {input_buffer} ]: \033[K")
        sys.stdout.flush()

    sys.stdout.write("\033[?25l") # Ocultar cursor
    try:
        render_menu()
        while True:
            ch = getch()
            if ch == '\x03': # Ctrl+C
                raise KeyboardInterrupt
            elif ch in ('\r', '\n'):
                sys.stdout.write("\n")
                break
            elif ch == ' ': # Espacio
                if multi:
                    if current_idx in selected_indices:
                        selected_indices.remove(current_idx)
                    else:
                        selected_indices.add(current_idx)
            elif ch in ('a', 'A'):
                if multi:
                    selected_indices = set(range(len(options)))
            elif ch in ('n', 'N'):
                if multi:
                    selected_indices.clear()
            elif ch == '\x1b[A': # Arriba
                current_idx = (current_idx - 1) % len(options)
                input_buffer = ""
            elif ch == '\x1b[B': # Abajo
                current_idx = (current_idx + 1) % len(options)
                input_buffer = ""
            elif ch == '\x1b[C': # Derecha
                current_idx = (current_idx + num_rows) % len(options)
                input_buffer = ""
            elif ch == '\x1b[D': # Izquierda
                current_idx = (current_idx - num_rows) % len(options)
                input_buffer = ""
            elif ch in ('\x7f', '\b'): # Backspace
                input_buffer = input_buffer[:-1]
                if input_buffer:
                    try:
                        num_val = int(input_buffer)
                        if 1 <= num_val <= len(options):
                            current_idx = num_val - 1
                    except ValueError:
                        pass
            elif len(ch) == 1 and ch.isdigit():
                new_buffer = input_buffer + ch
                try:
                    num_val = int(new_buffer)
                    if 1 <= num_val <= len(options):
                        input_buffer = new_buffer
                        current_idx = num_val - 1
                    else:
                        # Si el número completo no es válido, intentar solo con el último dígito
                        num_val = int(ch)
                        if 1 <= num_val <= len(options):
                            input_buffer = ch
                            current_idx = num_val - 1
                except ValueError:
                    pass

            # Regresar cursor arriba
            sys.stdout.write(f"\033[{lines_to_clear}F")
            render_menu()

        # Al salir, limpiar el menú de la pantalla para no ensuciar el log
        sys.stdout.write(f"\033[{lines_to_clear}A") # Subir al inicio del menú
        for _ in range(lines_to_clear + 1):
            sys.stdout.write("\033[K\n") # Limpiar línea y bajar
        sys.stdout.write(f"\033[{lines_to_clear + 1}F") # Regresar arriba de todo

    except (Exception, KeyboardInterrupt):
        sys.stdout.write("\n\033[?25hOperación cancelada.\n")
        sys.exit(0)
    finally:
        sys.stdout.write("\033[?25h") # Mostrar cursor

    if multi:
        return [options[i][1] for i in sorted(list(selected_indices))]
    return options[current_idx][1]


def prompt_for_instance(config, action):
    instances = list(config.get("instances", {}).keys())
    if not instances:
        print("No hay instancias configuradas.")
        sys.exit(1)

    allow_all_actions = {"start", "stop", "restart", "logs", "remove", "fix-files", "init"}
    allow_all = action in allow_all_actions

    options = []
    if allow_all:
        options.append(("Todas las instancias", None))
    for name in instances:
        options.append((name, name))
    
    return prompt_selection(options, "Selecciona una instancia (Usa las flechas, números y Enter para confirmar)")


def prompt_for_database(config, instance, allow_all=False):
    databases = get_databases(config, instance)
    if not databases:
        all_hint = " (o 'all')" if allow_all else ""
        return input(
            f"\nNo se pudieron auto-detectar bases de datos. "
            f"Ingresa el nombre de la base de datos para '{instance}'{all_hint}: "
        ).strip()

    options = []
    if allow_all:
        options.append(("all (todas las bases de datos)", "all"))
    options.extend((db, db) for db in databases)
    return prompt_selection(options, f"Selecciona base de datos para '{instance}'")


def prompt_for_modules(config, instance, dbname=None):
    modules = get_custom_modules(config, instance, dbname)
    if not modules:
        print(f"\nNo se encontraron módulos custom en los addons de '{instance}'.")
        return "all"
    
    options = [(mod, mod) for mod in modules]
    selected = prompt_selection(options, f"Selecciona módulos a actualizar para '{instance}' (Espacio para marcar, Enter para confirmar)", multi=True)
    if not selected:
        return "all"
    return ",".join(selected)


def main():
    os.chdir(BASE_PATH)

    parser = argparse.ArgumentParser(
        description="Multi-instance Odoo Docker management CLI."
    )
    subparsers = parser.add_subparsers(dest="action", help="Comandos disponibles")

    # build
    build_p = subparsers.add_parser("build", help="Genera configs y construye imágenes Docker")
    build_p.add_argument("--no-cache", action="store_true", help="Construir sin caché")

    # start
    start_p = subparsers.add_parser("start", help="Inicia instancia(s) de Odoo")
    start_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional, sin argumento inicia todas)")

    # stop
    stop_p = subparsers.add_parser("stop", help="Detiene instancia(s) de Odoo")
    stop_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")

    # restart
    restart_p = subparsers.add_parser("restart", help="Reinicia instancia(s) de Odoo")
    restart_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")

    # bash
    bash_p = subparsers.add_parser("bash", help="Abre bash en un contenedor Odoo")
    bash_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")

    # logs
    logs_p = subparsers.add_parser("logs", help="Muestra logs en tiempo real")
    logs_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")

    # list
    subparsers.add_parser("list", help="Lista contenedores en ejecución")

    # remove
    remove_p = subparsers.add_parser("remove", help="Elimina contenedores y volúmenes")
    remove_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")

    # fix-files
    fix_p = subparsers.add_parser("fix-files", help="Corrige permisos del filestore")
    fix_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")

    # psql
    psql_p = subparsers.add_parser("psql", help="Conectar a PostgreSQL")
    psql_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")
    psql_p.add_argument("-d", required=False, help="Nombre de la base de datos (opcional)")

    # pw
    pw_p = subparsers.add_parser("pw", help="Restablecer contraseña de un usuario")
    pw_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")
    pw_p.add_argument("-d", required=False, help="Nombre de la base de datos (opcional)")
    pw_p.add_argument("-l", help="Login a restablecer (opcional)")
    pw_p.add_argument("-p", "--password", default="admin", help="Nueva contraseña (por defecto: admin)")

    # update
    update_p = subparsers.add_parser("update", help="Actualizar módulos de Odoo")
    update_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")
    update_p.add_argument("-d", required=False, help="Nombre de la base de datos o 'all' (opcional)")
    update_p.add_argument("-m", default=None, help="Módulos a actualizar (opcional)")

    # init
    init_p = subparsers.add_parser("init", help="Inicializar addons/repositorios")
    init_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia (opcional)")

    # sync
    sync_p = subparsers.add_parser("sync", help="Sincroniza submódulos de un repositorio")
    sync_p.add_argument("r", nargs="?", default=None, help="Repositorio (opcional)")
    sync_p.add_argument("b", nargs="?", default=None, help="Branch (opcional)")
    sync_p.add_argument("--v", action="store_true", default=False, help="Mostrar salida de git")

    # migration-homo
    migration_homo_p = subparsers.add_parser("migration-homo", help="Migración a homologados: info, instalar y/o desinstalar módulos")
    migration_homo_p.add_argument("instance", nargs="?", default=None, help="Nombre de instancia o 'info' para ver estado")
    migration_homo_p.add_argument("info_instance", nargs="?", default=None, help="Nombre de instancia (cuando se usa 'info')")
    migration_homo_p.add_argument("-d", required=False, help="Nombre de la base de datos (opcional)")
    migration_homo_p.add_argument("--install", action="store_true", default=False, help="Instalar módulos l10n_ve_ equivalentes")
    migration_homo_p.add_argument("--uninstall", action="store_true", default=False, help="Desinstalar módulos binaural_ migrados")

    args = parser.parse_args()

    if not args.action:
        parser.print_help()
        return

    # Load config for all commands
    config = load_config(BASE_PATH)

    actions_with_instance = {
        "start", "stop", "restart", "logs", "remove", 
        "fix-files", "init", "bash", "psql", "pw", "update", "migration-homo"
    }
    
    if args.action in actions_with_instance and getattr(args, "instance", None) is None:
        args.instance = prompt_for_instance(config, args.action)

    # Dispatch
    if args.action == "build":
        build_odoo(config, args.no_cache)
    elif args.action == "start":
        start_odoo(config, args.instance)
    elif args.action == "stop":
        stop_odoo(config, args.instance)
    elif args.action == "restart":
        restart_odoo(config, args.instance)
    elif args.action == "bash":
        run_bash(config, args.instance)
    elif args.action == "logs":
        show_logs(config, args.instance)
    elif args.action == "list":
        list_containers(config)
    elif args.action == "remove":
        remove_odoo(config, args.instance)
    elif args.action == "fix-files":
        fix_filestore(config, args.instance)
    elif args.action == "psql":
        if args.d is None:
            args.d = prompt_for_database(config, args.instance)
        psql_connect(config, args.instance, args.d)
    elif args.action == "pw":
        if args.d is None:
            args.d = prompt_for_database(config, args.instance)
        if args.l is None:
            args.l = prompt_for_user(config, args.instance, args.d)
        reset_password(config, args.instance, args.d, args.l, args.password)
    elif args.action == "update":
        if args.instance is None:
            args.instance = prompt_for_instance(config, "update")
        if args.d is None:
            args.d = prompt_for_database(config, args.instance, allow_all=True)
        if args.m is None:
            args.m = prompt_for_modules(config, args.instance)
        if args.d.strip().lower() == "all":
            databases = get_databases(config, args.instance)
            if not databases:
                print("No se encontraron bases de datos para actualizar.")
                sys.exit(1)

            failures = []
            for db_name in databases:
                result = bash_update_modules(config, args.instance, db_name, args.m)
                if result != 0:
                    failures.append((db_name, result))

            if failures:
                print("\n❌ Algunas bases fallaron durante la actualización:")
                for db_name, code in failures:
                    print(f"  - {db_name} (exit code: {code})")
                sys.exit(1)
        else:
            bash_update_modules(config, args.instance, args.d, args.m)
    elif args.action == "migration-homo":
        if args.instance == "info" or args.instance is None:
            if args.instance == "info" and args.info_instance:
                args.instance = args.info_instance
            else:
                if args.instance == "info":
                    args.instance = None
                args.instance = prompt_for_instance(config, "migration-homo")
            if args.d is None:
                args.d = prompt_for_database(config, args.instance)
            show_binaural_modules(config, args.instance, args.d)
        elif args.install or args.uninstall:
            if args.d is None:
                args.d = prompt_for_database(config, args.instance)
            migration_homo_run(config, args.instance, args.d, args.install, args.uninstall)
        else:
            if args.d is None:
                args.d = prompt_for_database(config, args.instance)
            show_binaural_modules(config, args.instance, args.d)
    elif args.action == "init":
        init_addons(config, args.instance)
    elif args.action == "sync":
        if args.r is None:
            args.r = prompt_for_repos()
        if args.b is None:
            args.b = prompt_for_branch(args.r if isinstance(args.r, str) else None)
        sync(args.r, args.b, show=args.v)


if __name__ == "__main__":
    main()
