    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )

    # fix-files
    p = subparsers.add_parser(
        "fix-files", help="Corrige permisos del filestore"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )

    # psql
    p = subparsers.add_parser(
        "psql", help="Conectar a PostgreSQL"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )
    p.add_argument(
        "-d", required=False,
        help="Nombre de la base de datos (opcional)",
