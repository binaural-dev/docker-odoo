                else:
                    tag = "\033[91m ⚠️  DEBE instalarse\033[0m" if is_install_mandatory else ""
                    if is_never_uninstall:
                        tag += " \033[1;35m🔒 Debe mantenerse instalado\033[0m"
                    print(f"  {bmod:38s} → {l10n_equiv:30s}  \033[93m⬜ Pendiente\033[0m{tag}")

        if m["matched"] == 0:
            print(f"\n  Ninguno de los módulos binaural_ instalados tiene equivalente directo en odoo-venezuela.")

        if m["pending_install"]:
            print(f"\n\033[93m  📋 Módulos pendientes por instalar ({len(m['pending_install'])}):\033[0m")
