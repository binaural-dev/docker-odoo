        if m["already_l10n_only"]:
            print(f"\n\033[90m  ℹ️  Otros l10n_ve_ ya instalados (sin equivalente binaural_ instalado):\033[0m")
            for mod in m["already_l10n_only"]:
                print(f"    • {mod}")

        if m["to_uninstall_ready"] or m["to_uninstall_after"] or m["forced_uninstall"]:
            print(f"\n\033[1;31m=== 🗑️  MÓDULOS A DESINSTALAR DE INTEGRA (después de migrar) ===\033[0m\n")
            print(f"  {'Módulo (integra)':38s}  Estado")
