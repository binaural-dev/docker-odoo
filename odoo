def migration_homo_run(config, instance, dbname, do_install=False, do_uninstall=False):
    """Run migration-homo --install / --uninstall: install l10n_ve_, uninstall binaural_."""
    m = _compute_migration_map(config, instance, dbname)

    if not m["available_l10n"]:
        print("\033[93m⚠️  No se puede migrar sin odoo-venezuela. Clónalo primero.\033[0m")
        return

    # 1. Buscar vistas personalizadas (Studio/custom) que heredan de vistas binaural_
    all_binaural_to_uninstall = m["all_to_uninstall"]
    studio_views = []
    if all_binaural_to_uninstall:
        print(f"\033[1;33m  🔍 Buscando vistas personalizadas que dependen de módulos binaural_...\033[0m")
        studio_views = _get_studio_views_inheriting_from_modules(config, instance, dbname, all_binaural_to_uninstall)

    # 2. Mostrar resumen enfocado según flags
    print(f"\n\033[1;36m{'='*60}\033[0m")
    print(f"\033[1;36m  RESUMEN DE OPERACIONES A REALIZAR\033[0m")
    print(f"\033[1;36m{'='*60}\033[0m")
    print(f"  Instancia : \033[1m{instance}\033[0m")
    print(f"  Base datos: \033[1m{dbname}\033[0m\n")

    has_work = False

    if do_install:
        if m["pending_install"]:
            has_work = True
            print(f"\033[1;35m  📦 MÓDULOS A INSTALAR ({len(m['pending_install'])}):\033[0m")
            for mod in m["pending_install"]:
                print(f"    • {mod}")
        else:
            print(f"\033[92m  📦 MÓDULOS A INSTALAR: 0 (todos ya instalados)\033[0m")

    if do_uninstall:
        if all_binaural_to_uninstall:
            has_work = True
            print(f"\n\033[1;31m  🗑️  MÓDULOS A DESINSTALAR ({len(all_binaural_to_uninstall)}):\033[0m")
            for bmod in all_binaural_to_uninstall:
                extra = ""
                suffix = bmod[len("binaural_"):]
                if suffix in m["must_uninstall_suffixes"]:
                    extra = " \033[91m[forzoso]\033[0m"
                print(f"    • {bmod}{extra}")
        else:
            print(f"\n\033[92m  🗑️  MÓDULOS A DESINSTALAR: 0\033[0m")

    if studio_views:
        print(f"\n\033[1;33m  ⚠️  VISTAS QUE SE DESACTIVARÁN ({len(studio_views)}):\033[0m")
        print(f"     (heredan de módulos binaural_ y pueden causar errores)")
        _list_disabled_studio_views(studio_views)
    elif do_install or do_uninstall:
        print(f"\n\033[92m  ✅ No se encontraron vistas personalizadas que dependan de módulos binaural_.\033[0m")

    # 3. Confirmación interactiva
    if do_install and do_uninstall:
        accion = "instalar y desinstalar"
    elif do_install:
        accion = "instalar"
    else:
        accion = "desinstalar"

    if not has_work:
        print(f"\033[93m  ⚠️  No hay módulos pendientes para {accion}.\033[0m\n")
        return

    print()
    choice = prompt_selection(
        [("Continuar → Ejecutar la migración", True),
         ("Cancelar", False)],
        f"¿Confirmas {accion} los módulos listados?"
    )

    if not choice:
        print(f"\n\033[93m  ❌ Migración cancelada por el usuario.\033[0m\n")
        return

    print(f"\n\033[92m  ✅ Confirmado. Iniciando migración...\033[0m")

    # 4. Desactivar vistas problemáticas
    if studio_views:
        print(f"\n\033[1;33m  Desactivando {len(studio_views)} vista(s) personalizada(s)...\033[0m")
        _disable_studio_views(config, instance, dbname, studio_views)

    install_ok = True
    uninstall_ok = True
    installed_modules = []
    failed_install_modules = []
    uninstalled_modules = []

    # 5. Instalar módulos l10n_ve_ (todos juntos para que Odoo resuelva dependencias)
    if do_install and m["pending_install"]:
        print(f"\n\033[1;35m{'='*60}\033[0m")
        print(f"\033[1;35m  PASO 1: INSTALANDO MÓDULOS HOMOLOGADOS ({len(m['pending_install'])})\033[0m")
        print(f"\033[1;35m{'='*60}\033[0m")
        for mod in m["pending_install"]:
            print(f"    • {mod}")
        print()
        if _run_odoo_module_op(config, instance, dbname, m["pending_install"], "install"):
            installed_modules = list(m["pending_install"])
        else:
            print(f"\n  \033[93m  ⚠️  Instalación conjunta falló. Reintentando uno por uno...\033[0m")
            for i, mod in enumerate(m["pending_install"], 1):
                print(f"\n  \033[1;35m[{i}/{len(m['pending_install'])}] {mod}\033[0m")
                if _run_odoo_module_op(config, instance, dbname, [mod], "install"):
                    installed_modules.append(mod)
                else:
                    failed_install_modules.append(mod)
                    install_ok = False

    # 6. Desinstalar módulos binaural_
    if do_uninstall and all_binaural_to_uninstall:
        print(f"\n\033[1;33m{'='*60}\033[0m")
        print(f"\033[1;33m  ATENCION: MIGRACION DE MODULOS CUSTOM\033[0m")
        print(f"\033[1;33m{'='*60}\033[0m")
        print(f"\n  Antes de desinstalar modulos binaural_*, debes migrar las referencias")
        print(f"  en los modulos custom del cliente (binaural_* -> l10n_ve_*).")
        print(f"  Ejecuta el agente de migracion desde el repositorio custom:")
        print(f"\n    \033[1mcd src/custom/<repo-del-cliente>")
        print(f"    opencode")
        print(f"    @mig-customs-to-homo\033[0m")
        print(f"\n  O realiza la migracion manualmente antes de continuar.")
        choice = prompt_selection(
            [("Si, ya migre los modulos custom. Continuar con la desinstalacion.", True),
             ("No, cancelar desinstalacion.", False)],
            "Ya migraste las referencias binaural_* -> l10n_ve_* en los modulos custom del cliente?"
        )
        if not choice:
            print(f"\n\033[93m  Cancelada la desinstalacion. Migra los customs primero.\033[0m")
            print(f"\033[90m  Si ya los migraste, vuelve a ejecutar: ./odoo migration-homo {instance} -d {dbname} --uninstall\033[0m\n")
            return
        skip_binaural = set()

        if do_install and installed_modules:
            for bmod in all_binaural_to_uninstall:
                suffix = bmod[len("binaural_"):]
                if suffix in m["must_uninstall_suffixes"]:
                    continue
                l10n_suffix = m.get("manual_suffix_map", {}).get(suffix, suffix)
                l10n_equiv = "l10n_ve_" + l10n_suffix
                if l10n_equiv in m["available_l10n"] and l10n_equiv not in installed_modules and l10n_equiv not in m["installed_l10n"]:
                    skip_binaural.add(bmod)

        to_uninstall = [b for b in all_binaural_to_uninstall if b not in skip_binaural]

        if skip_binaural:
            print(f"\n\033[1;33m  ⚠️  Se omite desinstalación de ({len(skip_binaural)}): {', '.join(sorted(skip_binaural))}\033[0m")
            print(f"     (su equivalente l10n_ve_ no se instaló correctamente)")

        if to_uninstall:
            print(f"\n\033[1;31m{'='*60}\033[0m")
            step = "2" if (do_install and m["pending_install"]) else "1"
            print(f"\033[1;31m  PASO {step}: DESINSTALANDO MÓDULOS BINAURAL_ ({len(to_uninstall)})\033[0m")
            print(f"\033[1;31m{'='*60}\033[0m")
            if _run_odoo_module_op(config, instance, dbname, to_uninstall, "uninstall"):
                uninstalled_modules = to_uninstall
            else:
                uninstall_ok = False
        else:
            print(f"\n\033[92m  ✅ No hay módulos binaural_ para desinstalar en este momento.\033[0m")

    # 7. Resumen final
    print(f"\n\033[1;36m{'='*60}\033[0m")
    print(f"\033[1;36m  RESUMEN FINAL\033[0m")
    print(f"\033[1;36m{'='*60}\033[0m")
    if do_install and m["pending_install"]:
        if installed_modules:
            print(f"  ✅ Instalados: {', '.join(installed_modules)}")
        if failed_install_modules:
            print(f"  ❌ Fallidos: {', '.join(failed_install_modules)}")
            print(f"     Revisa los logs: \033[90m./odoo logs {instance}\033[0m")
    if do_uninstall and all_binaural_to_uninstall:
        if uninstalled_modules:
            print(f"  🗑️  Desinstalados: {', '.join(uninstalled_modules)}")
        elif uninstall_ok:
            pass
        else:
            print(f"  ❌ Desinstalación fallida")
    if studio_views:
        print(f"\n\033[1;33m  ⚠️  Quedaron {len(studio_views)} vista(s) desactivada(s). Revísalas en Odoo:\033[0m")
        print(f"     Menú Técnico > Vistas > filtrar por 'active = false'")
        _list_disabled_studio_views(studio_views)

    print()


