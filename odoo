#!/usr/bin/env python3

"""
Multi-instance Odoo Docker management CLI.

Thin dispatcher: parses argparse, builds a :class:`CliRunner`, then
hands control to :func:`odoo_cli.core.dispatch.dispatch` which calls
the appropriate action module under :mod:`odoo_cli.core.actions`.

The actual business logic lives in :mod:`odoo_cli.core`. This file
exists only to:

  1. Build the argparse subparser tree (one per CLI subcommand).
  2. Bootstrap the runner and the ``BASE_PATH`` / ``sys.path`` so
     the ``.resources/generators`` modules can be imported.
  3. Add the ``tui`` subcommand, which delegates to
     :mod:`tui.__main__`.

Future Textual integration
--------------------------
The Textual TUI (in :mod:`tui`) is independent for now: it spawns
``./odoo <action> ...`` via :mod:`tui.actions`, which means each
action runs in its own subprocess and prints to the TUI's
log widget. A future refactor could:

  1. Add a :class:`odoo_cli.core.runner.TextualRunner` that
     implements the same :class:`Runner` protocol but routes
     I/O through Textual widgets.
  2. Have the TUI import :mod:`odoo_cli.core.dispatch` directly
     and call ``dispatch(textual_runner, args, config, base_path)``
     from a worker thread.

That would eliminate the per-action subprocess and let the TUI
control every print/log line in real time. Out of scope for this
batch.
"""

import argparse
import os
import subprocess
import sys
from pathlib import Path

# Add .resources to path so ``from generators.config_loader import ...``
# works inside the action modules. The same hack is used by the TUI
# (see ``tui/config.py``).
BASE_PATH = str(Path(__file__).resolve().parent)
sys.path.insert(0, os.path.join(BASE_PATH, ".resources"))

from generators.config_loader import load_config

from odoo_cli.core.cli_runner import CliRunner
from odoo_cli.core.actions.validate import validate_instances
from odoo_cli.core.dispatch import dispatch


# ============================================================
# Argparse subparser tree
# ============================================================


def _build_parser() -> argparse.ArgumentParser:
    """Return the full argparse parser with every subcommand wired in.

    Keeping this in its own function (rather than inline in ``main``)
    makes the parser easy to introspect from tests and from the
    Textual TUI if it ever wants to introspect the CLI.
    """
    parser = argparse.ArgumentParser(
        prog="odoo",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "CLI de gestión de instancias Odoo multi-cliente sobre Docker.\n\n"
            "Cada cliente vive en src/custom/<nombre>/ y tiene su entrada en\n"
            "instances.json (config + base de datos + puerto). Usa\n"
            "'./odoo <comando> --help' para ver las opciones de cada comando."
        ),
        epilog=(
            "Comandos por categoría:\n"
            "  Ciclo de vida       build, start, stop, restart, remove, fix-files\n"
            "  Acceso / debug      bash, logs, list, psql, pw\n"
            "  Módulos             update, init, test\n"
            "  Git / submódulos    sync, update-tags, update-tags-bulk, "
            "submodule-status\n"
            "  Cobertura de tests  coverage-status, coverage\n"
            "  Config / infra      new, hosts, validate-instances, tui\n"
            "\n"
            "Ejemplos:\n"
            "  ./odoo start contiflex               levanta sólo esa instancia\n"
            "  ./odoo bash contiflex                shell root en el contenedor\n"
            "  ./odoo sync contiflex staging        stash+checkout+pull+submodules\n"
            "  ./odoo coverage-status               qué clientes tienen tests (sin Docker)\n"
            "  ./odoo coverage contiflex --dry-run  ve el plan de coverage sin ejecutar nada\n"
            "\n"
            "La mayoría de los comandos con instancia opcional preguntan de forma\n"
            "interactiva cuál usar si no la pasás como argumento."
        ),
    )
    subparsers = parser.add_subparsers(
        dest="action", help="Comandos disponibles"
    )

    # build
    p = subparsers.add_parser(
        "build",
        help="Genera configs y construye imágenes Docker",
        description=(
            "Genera Dockerfiles/compose/nginx para TODAS las instancias y "
            "corre 'docker compose build' sin acotar a ninguna. Puede tardar "
            "mucho y usar mucho disco si hay muchas instancias — para "
            "buildear una sola imagen puntual, usa "
            "'docker compose -f docker-compose.generated.yml build odoo-<instancia>' "
            "en su lugar."
        ),
    )
    p.add_argument(
        "--no-cache", action="store_true", help="Construir sin caché"
    )

    # start
    p = subparsers.add_parser(
        "start", help="Inicia instancia(s) de Odoo"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional, sin argumento inicia todas)",
    )

    # stop
    p = subparsers.add_parser(
        "stop", help="Detiene instancia(s) de Odoo"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )

    # restart
    p = subparsers.add_parser(
        "restart", help="Reinicia instancia(s) de Odoo"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )

    # bash
    p = subparsers.add_parser(
        "bash", help="Abre bash en un contenedor Odoo"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )

    # logs
    p = subparsers.add_parser(
        "logs", help="Muestra logs en tiempo real"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )

    # list
    subparsers.add_parser(
        "list", help="Lista contenedores en ejecución"
    )

    # remove
    p = subparsers.add_parser(
        "remove", help="Elimina contenedores y volúmenes"
