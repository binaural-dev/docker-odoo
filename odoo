    p.add_argument(
        "-m", default=None, help="Módulos a actualizar (opcional)"
    )

    # init
    p = subparsers.add_parser(
        "init",
        help="Reporta qué addons faltan clonar (solo lectura, no clona)",
        description=(
            "Inspecciona los addon paths de la instancia (o de todas) y "
