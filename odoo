#!/usr/bin/env python3

"""
Multi-instance Odoo Docker management CLI.

Thin dispatcher: parses argparse, builds a :class:`CliRunner`, then
hands control to :func:`odoo_cli.core.dispatch.dispatch` which calls
the appropriate action module under :mod:`odoo_cli.core.actions`.

The actual business logic lives in :mod:`odoo_cli.core`. This file
exists only to:

  1. Build the argparse subparser tree (one per CLI subcommand).
  2. Bootstrap the runner and the ``BASE_PATH`` / ``sys.path`` so
     the ``.resources/generators`` modules can be imported.
  3. Add the ``tui`` subcommand, which delegates to
     :mod:`tui.__main__`.

Future Textual integration
--------------------------
The Textual TUI (in :mod:`tui`) is independent for now: it spawns
``./odoo <action> ...`` via :mod:`tui.actions`, which means each
action runs in its own subprocess and prints to the TUI's
log widget. A future refactor could:

  1. Add a :class:`odoo_cli.core.runner.TextualRunner` that
     implements the same :class:`Runner` protocol but routes
     I/O through Textual widgets.
  2. Have the TUI import :mod:`odoo_cli.core.dispatch` directly
     and call ``dispatch(textual_runner, args, config, base_path)``
     from a worker thread.

That would eliminate the per-action subprocess and let the TUI
control every print/log line in real time. Out of scope for this
batch.
"""

import argparse
import os
import sys
from pathlib import Path

# Add .resources to path so ``from generators.config_loader import ...``
# works inside the action modules. The same hack is used by the TUI
# (see ``tui/config.py``).
BASE_PATH = str(Path(__file__).resolve().parent)
sys.path.insert(0, os.path.join(BASE_PATH, ".resources"))

from generators.config_loader import load_config

from odoo_cli.core.cli_runner import CliRunner
from odoo_cli.core.actions.validate import validate_instances
from odoo_cli.core.dispatch import dispatch


# ============================================================
# Argparse subparser tree
# ============================================================


def _build_parser() -> argparse.ArgumentParser:
    """Return the full argparse parser with every subcommand wired in.

    Keeping this in its own function (rather than inline in ``main``)
    makes the parser easy to introspect from tests and from the
    Textual TUI if it ever wants to introspect the CLI.
    """
    parser = argparse.ArgumentParser(
        description="Multi-instance Odoo Docker management CLI."
    )
    subparsers = parser.add_subparsers(
        dest="action", help="Comandos disponibles"
    )

    # build
    p = subparsers.add_parser(
        "build", help="Genera configs y construye imágenes Docker"
    )
    p.add_argument(
        "--no-cache", action="store_true", help="Construir sin caché"
    )

    # start
    p = subparsers.add_parser(
        "start", help="Inicia instancia(s) de Odoo"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional, sin argumento inicia todas)",
    )

    # stop
    p = subparsers.add_parser(
        "stop", help="Detiene instancia(s) de Odoo"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )

    # restart
    p = subparsers.add_parser(
        "restart", help="Reinicia instancia(s) de Odoo"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )

    # bash
    p = subparsers.add_parser(
        "bash", help="Abre bash en un contenedor Odoo"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )

    # logs
    p = subparsers.add_parser(
        "logs", help="Muestra logs en tiempo real"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )

    # list
    subparsers.add_parser(
        "list", help="Lista contenedores en ejecución"
    )

    # remove
    p = subparsers.add_parser(
        "remove", help="Elimina contenedores y volúmenes"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )

    # fix-files
    p = subparsers.add_parser(
        "fix-files", help="Corrige permisos del filestore"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )

    # psql
    p = subparsers.add_parser(
        "psql", help="Conectar a PostgreSQL"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )
    p.add_argument(
        "-d", required=False,
        help="Nombre de la base de datos (opcional)",
    )

    # pw
    p = subparsers.add_parser(
        "pw", help="Restablecer contraseña de un usuario"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )
    p.add_argument(
        "-d", required=False,
        help="Nombre de la base de datos (opcional)",
    )
    p.add_argument(
        "-l", help="Login a restablecer (opcional)"
    )
    p.add_argument(
        "-p", "--password", default="admin",
        help="Nueva contraseña (por defecto: admin)",
    )

    # update
    p = subparsers.add_parser(
        "update", help="Actualizar módulos de Odoo"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )
    p.add_argument(
        "-d", required=False,
        help="Nombre de la base de datos o 'all' (opcional)",
    )
    p.add_argument(
        "-m", default=None, help="Módulos a actualizar (opcional)"
    )

    # init
    p = subparsers.add_parser(
        "init", help="Inicializar addons/repositorios"
    )
    p.add_argument(
        "instance", nargs="?", default=None,
        help="Nombre de instancia (opcional)",
    )

    # sync
    p = subparsers.add_parser(
        "sync", help="Sincroniza submódulos de un repositorio"
    )
    p.add_argument(
        "r", nargs="?", default=None, help="Repositorio (opcional)"
    )
    p.add_argument(
        "b", nargs="?", default=None, help="Branch (opcional)"
    )
    p.add_argument(
        "--v", action="store_true", default=False,
        help="Mostrar salida de git",
    )

    # update-tags
    p = subparsers.add_parser(
        "update-tags",
        help="Actualiza un submódulo a un tag en una rama nueva para PR",
    )
    p.add_argument(
        "proyecto", nargs="?", default=None,
        help="Proyecto en src/custom/ (opcional, se pregunta si falta)",
    )
    p.add_argument(
        "branch_origin", nargs="?", default=None,
        help="Rama base para pull y para crear la rama nueva (opcional)",
    )
    p.add_argument(
        "submodulo", nargs="?", default=None,
        help="Submódulo a actualizar (opcional)",
    )
    p.add_argument(
        "tag", nargs="?", default=None,
        help="Tag exacto a checkear (opcional)",
    )
    p.add_argument(
        "--v", action="store_true", default=False,
        help="Mostrar salida de git",
    )

    # submodule-status
    p = subparsers.add_parser(
        "submodule-status",
        help="Muestra en qué tag/rama/hash está parado cada submódulo (solo lectura)",
    )
    p.add_argument(
        "proyecto", nargs="?", default=None,
        help="Proyecto en src/custom/ (opcional; sin esto corre sobre todos)",
    )

    # validate-instances
    subparsers.add_parser(
        "validate-instances", help="Valida el archivo instances.json"
    )

    # hosts — sync /etc/hosts with subdomains declared in instances.json
    p = subparsers.add_parser(
        "hosts",
        help="Sincroniza /etc/hosts con los subdominios de las instances",
    )
    p.add_argument(
        "hosts_mode", nargs="?", default="status",
        choices=["status", "show", "apply", "dry-run"],
        help="status (default) | show | apply | dry-run",
    )

    # new
    p = subparsers.add_parser(
        "new",
        help="Crea una nueva instancia (interactivo o por argumentos)",
    )
    p.add_argument("name", nargs="?", default=None, help="Nombre de instancia")
    p.add_argument("repo", nargs="?", default=None, help="URL del repositorio (SSH)")
    p.add_argument("branch", nargs="?", default=None, help="Rama del repositorio")
    p.add_argument("version", nargs="?", default=None, help="Versión de Odoo")

    # tui — thin entry point that hands off to the Textual app
    subparsers.add_parser(
        "tui", help="Abre el launcher interactivo (Textual)",
    )

    return parser


# ============================================================
# Main
# ============================================================


def main() -> int:
    """CLI entry point. Returns the process exit code."""
    os.chdir(BASE_PATH)

    parser = _build_parser()
    args = parser.parse_args()

    if not args.action:
        parser.print_help()
        return 0

    runner = CliRunner()

    # The dispatch tree loads the config (which exits if instances.json
    # is missing) and validates it (which exits on duplicate ports /
    # missing databases). Both are runner-aware: errors go through
    # ``runner.error``.
    config = load_config(BASE_PATH)
    validate_instances(runner, config)

    return dispatch(runner, args, config, BASE_PATH)


if __name__ == "__main__":
    sys.exit(main())
