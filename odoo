def _compute_migration_map(config, instance, dbname):
    binaural_mods = get_installed_binaural_modules(config, instance, dbname)
    available_l10n, ve_source = get_available_l10n_ve_modules(config, instance)
    installed_l10n = get_installed_l10n_ve_modules(config, instance, dbname) if available_l10n else []

    mandatory_install_suffixes = {"purchase"}
    must_uninstall_suffixes = {"igtf", "fiscal", "base_igtf"}
    never_uninstall_suffixes = {"purchase"}
    manual_suffix_map = {
        "stock_accountant": "stock_account",
    }

    pending_install = []
    to_uninstall_ready = []
    to_uninstall_after = []
    matched = 0

    for bmod in binaural_mods:
        suffix = bmod[len("binaural_"):]
        l10n_suffix = manual_suffix_map.get(suffix)
        if l10n_suffix is None:
            l10n_suffix = suffix
        l10n_equiv = "l10n_ve_" + l10n_suffix
        if l10n_equiv in available_l10n:
            matched += 1
            is_never_uninstall = suffix in never_uninstall_suffixes
            if l10n_equiv in installed_l10n:
                if not is_never_uninstall:
                    to_uninstall_ready.append(bmod)
            else:
                pending_install.append(l10n_equiv)
                if not is_never_uninstall:
                    to_uninstall_after.append(bmod)

    binaural_suffixes = set(m[len("binaural_"):] for m in binaural_mods)
    already_l10n_only = [m for m in installed_l10n if m[len("l10n_ve_"):] not in binaural_suffixes]

    forced_uninstall = []
    for bmod in binaural_mods:
        suffix = bmod[len("binaural_"):]
        if suffix in must_uninstall_suffixes and bmod not in to_uninstall_ready and bmod not in to_uninstall_after:
            forced_uninstall.append(bmod)

    all_to_uninstall = to_uninstall_ready + to_uninstall_after + forced_uninstall

    return {
        "binaural_mods": binaural_mods,
        "available_l10n": available_l10n,
        "ve_source": ve_source,
        "installed_l10n": installed_l10n,
        "pending_install": pending_install,
        "to_uninstall_ready": to_uninstall_ready,
        "to_uninstall_after": to_uninstall_after,
        "forced_uninstall": forced_uninstall,
        "all_to_uninstall": all_to_uninstall,
        "matched": matched,
        "mandatory_install_suffixes": mandatory_install_suffixes,
        "must_uninstall_suffixes": must_uninstall_suffixes,
        "never_uninstall_suffixes": never_uninstall_suffixes,
        "already_l10n_only": already_l10n_only,
        "manual_suffix_map": manual_suffix_map,
    }


