<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_sale_commission" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale.commission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_recompute_commissions" type="object" string="Recalcular comisiones"
                        invisible="state != 'sale'"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='price_subtotal']" position="after">
                <field name="commission_percent" optional="hide"/>
                <field name="commission_amount" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
