<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_inspection_vehicle_type_view_tree" model="ir.ui.view">
        <field name="name">fleet.inspection.vehicle.type.tree</field>
        <field name="model">fleet.inspection.vehicle.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="fleet_inspection_vehicle_type_view_form" model="ir.ui.view">
        <field name="name">fleet.inspection.vehicle.type.form</field>
        <field name="model">fleet.inspection.vehicle.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de vehículo para inspección">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fleet_inspection_vehicle_type_action" model="ir.actions.act_window">
        <field name="name">Tipos de vehículo</field>
        <field name="res_model">fleet.inspection.vehicle.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un nuevo tipo de vehículo para las inspecciones
            </p>
        </field>
    </record>
</odoo>

