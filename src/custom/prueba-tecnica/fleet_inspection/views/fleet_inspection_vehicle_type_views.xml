<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_inspection_vehicle_type_view_list" model="ir.ui.view">
        <field name="name">fleet.inspection.vehicle.type.list</field>
        <field name="model">fleet.inspection.vehicle.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="fleet_inspection_vehicle_type_action" model="ir.actions.act_window">
        <field name="name">Tipos de vehículo</field>
        <field name="res_model">fleet.inspection.vehicle.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
