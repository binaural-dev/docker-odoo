<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_inspection_item_view_list" model="ir.ui.view">
        <field name="name">fleet.inspection.item.list</field>
        <field name="model">fleet.inspection.item</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="critical"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="fleet_inspection_item_action" model="ir.actions.act_window">
        <field name="name">Puntos del checklist</field>
        <field name="res_model">fleet.inspection.item</field>
        <field name="view_mode">list</field>
    </record>
</odoo>