<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_inspection_item_view_tree" model="ir.ui.view">
        <field name="name">fleet.inspection.item.tree</field>
        <field name="model">fleet.inspection.item</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="critical"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="fleet_inspection_item_action" model="ir.actions.act_window">
        <field name="name">Puntos del checklist</field>
        <field name="res_model">fleet.inspection.item</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
