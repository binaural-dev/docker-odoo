<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_payment_request" model="ir.module.category">
        <field name="name">Solicitudes de Pago</field>
        <field name="description">Control y aprobación de solicitudes de pago a proveedores</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_payment_request_user" model="res.groups">
        <field name="name">Solicitante</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_payment_request_approver" model="res.groups">
        <field name="name">Aprobador</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_request_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_payment_request_treasury" model="res.groups">
        <field name="name">Tesorería</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_request_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Reglas de registro -->
    <record id="payment_request_rule_user" model="ir.rule">
        <field name="name">Solicitudes de pago: el solicitante solo ve las suyas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[('applicant_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="payment_request_rule_approver" model="ir.rule">
        <field name="name">Solicitudes de pago: aprobador ve todas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_approver'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="payment_request_rule_treasury" model="ir.rule">
        <field name="name">Solicitudes de pago: tesorería ve todas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_treasury'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="payment_request_rule_company" model="ir.rule">
        <field name="name">Solicitudes de pago: regla multi-compañía</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="payment_approval_level_rule_company" model="ir.rule">
        <field name="name">Niveles de aprobación: regla multi-compañía</field>
        <field name="model_id" ref="model_payment_approval_level"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

