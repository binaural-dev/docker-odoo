<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_payment_request" model="ir.module.category">
        <field name="name">Solicitudes de pago</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_payment_request_user" model="res.groups">
        <field name="name">Solicitante</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <field name="comment">Pide pagos a proveedores y ve solo sus propias solicitudes.</field>
    </record>

    <record id="group_payment_request_approver" model="res.groups">
        <field name="name">Aprobador</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_request_user'))]"/>
        <field name="comment">Ve todas las solicitudes y las aprueba o rechaza.</field>
    </record>

    <record id="group_payment_request_treasury" model="res.groups">
        <field name="name">Tesorería</field>
        <field name="category_id" ref="module_category_payment_request"/>
        <!-- Registrar el pago crea un account.payment: requiere el grupo Facturación de Contabilidad. -->
        <field name="implied_ids" eval="[(4, ref('group_payment_request_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Ve todas las solicitudes y registra el pago de las aprobadas.</field>
    </record>

    <!-- «Cualquier empleado puede pedir un pago»: todo usuario interno es Solicitante. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_payment_request_approver')), (4, ref('group_payment_request_treasury'))]"/>
    </record>

    <record id="payment_request_rule_own" model="ir.rule">
        <field name="name">Solicitudes de pago: el solicitante ve las suyas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[('requester_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>

    <record id="payment_request_rule_approver" model="ir.rule">
        <field name="name">Solicitudes de pago: el aprobador ve todas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_approver'))]"/>
    </record>

    <record id="payment_request_rule_treasury" model="ir.rule">
        <field name="name">Solicitudes de pago: tesorería ve todas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_treasury'))]"/>
    </record>

    <record id="payment_request_rule_company" model="ir.rule">
        <field name="name">Solicitudes de pago: multicompañía</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
