{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "**/odoo-17.0/**": "deny",
      "**/odoo-19.0/**": "deny",
      "**/enterprise-17.0/**": "deny",
      "**/enterprise-19.0/**": "deny"
    },
    "bash": {
      "docker exec*psql*": "deny",
      "docker compose exec*psql*": "deny",
      "docker-compose exec*psql*": "deny",
      "psql": "deny",
      "psql *": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git checkout --*": "deny",
      "rm -rf*": "deny",
      "*--no-verify*": "deny",
      "*--force*": "deny"
    }
  },
  "plugin": [
    "./opencode-plugins/sdd-odoo-guard.js",
    "./opencode-plugins/sdd-lean-ruleset.js",
    "./opencode-plugins/sdd-memory.js"
  ]
}
