#!/usr/bin/env python3
"""
Configuración post-restore para bases de datos de testing (Staging/QA).

Lo ejecuta `odoo_restore` al final de cada restore (y por lo tanto también
`odoo_restore_scp`, que restaura a través de `odoo_restore`), salvo que se
pase `--skip-post-restore`. También puede ejecutarse solo sobre una base
que ya exista.

Antes de los pasos de configuración se ejecuta `-u all` sobre la base
(se omite con `--skip-module-update`). Es best-effort: si sigue fallando
tras los reintentos, se avisa y la configuración se aplica igual.

Pasos de configuración. Los pasos 1, 2 y 3 van en este orden exacto
(obligatorio: `database_neutralize_toggle` bloquea la activación de Sandbox
Mode si el parámetro de sistema 'Environment' todavía indica producción);
el paso 4 es independiente de los demás:

  1. Ajusta el parámetro de sistema 'Environment' (prod -> Staging/QA). Si
     no se pasa `--environment`, se deduce de la instancia (bp-staging ->
     Staging, bp-qa -> QA) y para cualquier otra instancia se usa QA.
  2. Ajusta el parámetro de sistema 'bp_deploy_manager.default_branch' a la
     rama del entorno restaurado (staging -> 'staging', qa -> 'qa'; cualquier
     otro entorno -> 'qa'), si ese parámetro ya existe en la base. El dump de producción trae ese
     parámetro apuntando a 'release'; sin este paso, un deploy programado
     recién creado en la base restaurada arrancaría precargado con la rama
     de producción en vez de la rama que corresponde a Staging/QA.
  3. Activa Sandbox Mode a través del wizard de Ajustes Generales
     (res.config.settings), igual que si un usuario marcara el check y
     diera clic en "Guardar". Esto es lo que efectivamente desactiva los
     servidores de correo, fetchmail y crons (vía database_neutralize_toggle,
     que ya viene instalado en el dump de producción).
  4. Regenera los bundles de assets del frontend. El restore corre después
     de un `-u all` que puede dejar el bundle compilado (`ir.attachment` en
     `/web/assets/...`) desactualizado o corrupto respecto al código nuevo,
     lo que rompe con un 500 el JS/CSS de páginas como `/web/login`. Es el
     mismo efecto que el botón "Regenerar Activos" del menú de debug.

Todos los pasos corren en una sola sesión de `odoo shell` contra la base
recién restaurada, en el mismo contenedor que la va a servir.

La activación de Sandbox Mode puede chocar con una condición de carrera:
apenas la base queda visible tras el `-u all` previo, el scheduler de
crons del propio contenedor puede tomar y estar ejecutando alguno de los
`ir.cron` heredados de producción justo cuando `settings.execute()` intenta
desactivarlos todos, y Odoo bloquea la escritura sobre un cron en ejecución
(UserError "esta tarea de cron se está ejecutando..."). Por eso ese paso
reintenta con backoff antes de darse por vencido.
"""

import argparse
import subprocess
import sys
import time

ENVIRONMENT_PARAM = "Environment"
DEFAULT_BRANCH_PARAM = "bp_deploy_manager.default_branch"
# Valor de 'Environment' por instancia; cualquier otra instancia usa el default.
ENVIRONMENT_BY_INSTANCE = {
    "bp-staging": "Staging",
    "bp-qa": "QA",
}
DEFAULT_ENVIRONMENT = "QA"
ENVIRONMENT_BRANCH_MAP = {
    "staging": "staging",
    "qa": "qa",
}
DEFAULT_BRANCH = "qa"
SANDBOX_RETRY_ATTEMPTS = 5
SANDBOX_RETRY_DELAY_SECONDS = 10

# El contenedor destino es un servidor multi-tenant siempre corriendo
# (workers + hilo de cron) que sirve, vía `dbfilter`, cualquier base que
# calce con el prefijo de la instancia. Apenas la base recién restaurada
# queda visible, ese servidor puede engancharse a ella (cron, workers)
# justo cuando este `-u all` también la está tocando, y Postgres aborta
# una de las dos transacciones con "deadlock detected" sobre
# `ir_module_module`. Es una condición de carrera real contra el propio
# servidor, no un fallo aislado, así que se reintenta con backoff.
MODULE_UPDATE_RETRY_ATTEMPTS = 4
MODULE_UPDATE_RETRY_DELAY_SECONDS = 20


def resolve_environment(container, environment=None):
    if environment:
        return environment
    instance = container.removeprefix("odoo-")
    return ENVIRONMENT_BY_INSTANCE.get(instance, DEFAULT_ENVIRONMENT)


def run_module_update(container, db_name, odoo_bin="odoo"):
    cmd = [
        "docker", "exec", "-u", "root", container,
        odoo_bin, "--stop-after-init", "--no-http", "--workers=0",
        "-u", "all", "-d", db_name,
    ]

    result = None
    for attempt in range(1, MODULE_UPDATE_RETRY_ATTEMPTS + 1):
        print(
            f"\nActualizando modulos en '{db_name}' antes de la config "
            f"post-restore (intento {attempt}/{MODULE_UPDATE_RETRY_ATTEMPTS})...\n",
            flush=True,
        )
        result = subprocess.run(cmd)
        if result.returncode == 0:
            return True

        print(
            f"AVISO: la actualización de módulos en '{db_name}' terminó con "
            f"código {result.returncode} en el intento {attempt}/"
            f"{MODULE_UPDATE_RETRY_ATTEMPTS}.",
            flush=True,
        )
        if attempt < MODULE_UPDATE_RETRY_ATTEMPTS:
            time.sleep(MODULE_UPDATE_RETRY_DELAY_SECONDS)

    # Best-effort: si tras todos los reintentos sigue fallando, NO debe
    # abortar el resto. La config post-restore (Environment + Sandbox Mode)
    # tiene que ejecutarse siempre sobre la base recién restaurada.
    print(
        f"AVISO: la actualización de módulos en '{db_name}' siguió fallando "
        f"tras {MODULE_UPDATE_RETRY_ATTEMPTS} intentos (código "
        f"{result.returncode}). Se continúa con la configuración post-restore "
        "de todas formas; revisa el esquema de esta base si algo falla más "
        "adelante.",
        flush=True,
    )
    return False


def _build_branch_step(environment):
    target_branch = ENVIRONMENT_BRANCH_MAP.get(
        environment.strip().lower(), DEFAULT_BRANCH
    )

    return f'''
    if icp.get_param({DEFAULT_BRANCH_PARAM!r}) is not None:
        icp.set_param({DEFAULT_BRANCH_PARAM!r}, {target_branch!r})
        env.cr.commit()
        print("POST_RESTORE_STEP: {DEFAULT_BRANCH_PARAM} -> {target_branch}")
    else:
        print(
            "POST_RESTORE_SKIP_BRANCH: {DEFAULT_BRANCH_PARAM} no esta "
            "definido en esta base (bp_deploy_manager no instalado)"
        )
'''


def _build_shell_script(environment):
    branch_step = _build_branch_step(environment)
    return f'''
import sys
import time

try:
    icp = env["ir.config_parameter"].sudo()
    icp.set_param({ENVIRONMENT_PARAM!r}, {environment!r})
    env.cr.commit()
    print("POST_RESTORE_STEP: {ENVIRONMENT_PARAM} -> {environment}")
{branch_step}
    if "sandbox_mode" not in env["res.config.settings"]._fields:
        print(
            "POST_RESTORE_SKIP_SANDBOX: database_neutralize_toggle no esta "
            "instalado en esta base"
        )
    else:
        max_attempts = {SANDBOX_RETRY_ATTEMPTS}
        retry_delay = {SANDBOX_RETRY_DELAY_SECONDS}
        last_exc = None
        for attempt in range(1, max_attempts + 1):
            try:
                # El wizard (res.config.settings) se crea de nuevo en cada
                # intento: un rollback() por un fallo previo (p.ej. el cron
                # bloqueado) deshace también el create() anterior, así que
                # reutilizar el mismo registro en el siguiente intento
                # revienta con MissingError.
                settings = env["res.config.settings"].create({{}})
                settings.sandbox_mode = True
                settings.execute()
                env.cr.commit()
                last_exc = None
                break
            except Exception as exc:
                env.cr.rollback()
                last_exc = exc
                print(
                    "POST_RESTORE_SANDBOX_RETRY: intento %d/%d fallo: %r"
                    % (attempt, max_attempts, exc)
                )
                if attempt < max_attempts:
                    time.sleep(retry_delay)

        if last_exc is not None:
            raise last_exc

        print("POST_RESTORE_STEP: sandbox_mode -> True")
        print("POST_RESTORE_SANDBOX_APPLIED")

    env["ir.attachment"].sudo().regenerate_assets_bundles()
    env.cr.commit()
    print("POST_RESTORE_STEP: assets bundles regenerated")
    print("POST_RESTORE_ASSETS_REGENERATED")

    print("POST_RESTORE_OK")
except Exception as exc:
    env.cr.rollback()
    print("POST_RESTORE_FAILED: %r" % (exc,), file=sys.stderr)
    sys.exit(1)
'''


def run_post_restore(container, db_name, environment, odoo_bin="odoo", verbose=False):
    script = _build_shell_script(environment)

    cmd = [
        "docker", "exec", "-i", container,
        odoo_bin, "shell",
        "-d", db_name,
        "--no-http",
    ]

    if verbose:
        print(
            f"\nEjecutando post-restore en '{db_name}' (contenedor {container})...\n"
            f"Environment objetivo: {environment}\n"
        )

    result = subprocess.run(cmd, input=script, text=True, capture_output=True)

    if verbose or result.returncode != 0 or "POST_RESTORE_OK" not in result.stdout:
        if result.stdout:
            print(result.stdout)
        if result.stderr:
            print(result.stderr, file=sys.stderr)

    if result.returncode != 0 or "POST_RESTORE_OK" not in result.stdout:
        print(
            f"ERROR: post-restore falló para la base '{db_name}' "
            f"(contenedor {container}, environment={environment})",
            file=sys.stderr,
        )
        sys.exit(1)

    sandbox_note = (
        "Sandbox Mode activado"
        if "POST_RESTORE_SANDBOX_APPLIED" in result.stdout
        else "Sandbox Mode omitido (database_neutralize_toggle no instalado)"
    )
    print(
        f"post_restore_db: '{db_name}' -> {ENVIRONMENT_PARAM}={environment}, "
        f"{sandbox_note}, assets regenerados"
    )


def main():
    parser = argparse.ArgumentParser(
        description=(
            "Prepara una base de datos recién restaurada: actualiza módulos, "
            "ajusta 'Environment' y la rama por defecto, activa Sandbox Mode "
            "y regenera los assets."
        )
    )
    parser.add_argument(
        "--container", required=True, help="Contenedor Odoo, ej. odoo-bp-staging"
    )
    parser.add_argument(
        "--db-name", required=True, help="Base de datos recién restaurada"
    )
    parser.add_argument(
        "--environment",
        default=None,
        help=(
            "Valor a guardar en el parámetro de sistema 'Environment' (ej. Staging, QA). "
            "Default: según la instancia (bp-staging -> Staging, bp-qa -> QA); "
            f"cualquier otra -> {DEFAULT_ENVIRONMENT}"
        ),
    )
    parser.add_argument(
        "--skip-module-update",
        action="store_true",
        help="No ejecutar `-u all` antes de la configuración",
    )
    parser.add_argument(
        "--odoo-bin", default="odoo", help="Comando/binario odoo dentro del contenedor"
    )
    parser.add_argument("--verbose", action="store_true")
    args = parser.parse_args()

    if not args.skip_module_update:
        run_module_update(args.container, args.db_name, odoo_bin=args.odoo_bin)

    run_post_restore(
        container=args.container,
        db_name=args.db_name,
        environment=resolve_environment(args.container, args.environment),
        odoo_bin=args.odoo_bin,
        verbose=args.verbose,
    )


if __name__ == "__main__":
    main()
