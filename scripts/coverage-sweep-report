def build_css(lines):
    light, dark, extra = [], [], []
    for label in lines:
        st = LINE_STYLE.get(label)
        if not st:
            continue
        s = st["slug"]
        light.append(f"    --acc-{s}: {st['light']};")
        light.append(f"    --acc-{s}-soft: {st['soft_light']};")
        dark.append(f"      --acc-{s}: {st['dark']};")
        dark.append(f"      --acc-{s}-soft: {st['soft_dark']};")
        extra.append(
            f"  .acc-{s} {{ color: var(--acc-{s}); }}\n"
            f"  .bg-{s} {{ background: var(--acc-{s}); }}\n"
            f"  .bt-{s} {{ border-top-color: var(--acc-{s}); }}\n"
        )
    css = CSS.replace("__ACCENTS_LIGHT__", "\n".join(light))
    css = css.replace("__ACCENTS_DARK__", "\n".join(dark))
    return css + "\n" + "".join(extra)


