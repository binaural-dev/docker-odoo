#!/bin/bash

KEEP_DBS=("cdd-mercedes-staging" "yoha-funcional-staging")
DB_CONTAINER="db-pg16"
DB_EXEC="docker exec $DB_CONTAINER psql -U odoo -d postgres"

echo "=== Verificando container ==="
if ! docker ps --format '{{.Names}}' | grep -q "^$DB_CONTAINER$"; then
    echo "ERROR: Container '$DB_CONTAINER' no está corriendo."
    echo "Containers disponibles:"
    docker ps --format '{{.Names}}'
    exit 1
fi

echo "=== Listando bases de datos ==="
ALL_DBS=$($DB_EXEC -t -A -c "
    SELECT datname FROM pg_database
    WHERE datistemplate = false
      AND datname NOT IN ('postgres', 'odoo');
")

DROP_LIST=()
for db in $ALL_DBS; do
    keep=false
    for keep_db in "${KEEP_DBS[@]}"; do
        if [ "$db" = "$keep_db" ]; then
            keep=true
            break
        fi
    done
    if [ "$keep" = false ]; then
        DROP_LIST+=("$db")
    fi
done

if [ ${#DROP_LIST[@]} -eq 0 ]; then
    echo "No hay bases de datos que eliminar."
    exit 0
fi

echo ""
echo "Se eliminaran las siguientes bases de datos:"
printf '  - %s\n' "${DROP_LIST[@]}"
echo ""
read -p "Confirmar? (y/N): " confirm
if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
    echo "Cancelado."
    exit 1
fi

for db in "${DROP_LIST[@]}"; do
    echo "Eliminando $db ..."

    # Terminar conexiones activas y prevenir nuevas conexiones
    $DB_EXEC --no-psqlrc -c "UPDATE pg_database SET datallowconn = false WHERE datname = '$db';" 2>/dev/null
    $DB_EXEC --no-psqlrc -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$db';" 2>/dev/null

    # Usar dropdb en vez de DROP DATABASE SQL porque DROP DATABASE no puede
    # ejecutarse dentro de un bloque transaccional. dropdb maneja esto correctamente.
    docker exec "$DB_CONTAINER" dropdb -U odoo --if-exists "$db" 2>&1 || {
        echo "⚠️  dropdb falló para '$db', reintentando con psql..."
        $DB_EXEC --no-psqlrc -c "DROP DATABASE IF EXISTS \"$db\";" 2>&1
    }
done

echo "Listo."
