#!/usr/bin/env python3

import ast
import argparse
import datetime
import json
import os
import re
import subprocess
import sys
from pathlib import Path

BASE_PATH = str(Path(__file__).resolve().parent.parent)
sys.path.insert(0, os.path.join(BASE_PATH, ".resources"))
from generators.config_loader import load_config

USAGE = """\
Ejecuta los tests de uno o varios modulos de Odoo (y opcionalmente de todo su
subarbol de dependientes + dependencias) midiendo cobertura de codigo.

Se puede indicar mas de un modulo separando los nombres por coma (ej:
binaural_brand,binaural_mobile): se instalan y testean todos juntos, en la
misma base de datos y la misma corrida de coverage.

La instancia y el/los modulo(s) se pueden pasar posicionalmente o con
-i/--instance y -m/--modules (si se dan ambas formas, la flag tiene
prioridad).

FUNCIONAMIENTO
--------------
Por defecto (sin --recursive) solo se instalan y testean los modulos
indicados (equivalente a --tags /<modulo1>,/<modulo2>,...).

Con --recursive, el script escanea los __manifest__.py de los addons de la
instancia para construir el grafo de dependencias y calcula el subarbol
completo combinado de los modulos indicados:

  * el modulo en si,
  * todos los modulos que dependen de el (dependientes, transitivo),
  * todos los modulos de los que depende (dependencias, transitivo),

y ejecuta TODOS los tests de esos modulos (--test-tags /m1,/m2,... y -i m1,m2,...).
Antes de ejecutar, muestra el arbol en dos secciones (descendente: modulos de
los que depende; ascendente: modulos que dependen de el) con los caminos
completos hasta cada hoja, y pide confirmacion explicita para continuar
(por defecto NO se ejecuta si solo se presiona Enter).

Si --tags es distinto de "all", el valor se pasa tal cual a odoo --test-tags
(ej: /binaural_brand, /binaural_brand/test_costos, post_install, etc.),
independientemente de --recursive.

Con --exclude (solo tiene efecto junto con --recursive) se omiten modulos del
subarbol calculado (por nombre, separados por coma): sus tests no se ejecutan
ni se agregan a la instalacion.

Si algun modulo excluido es dependencia de otros modulos del subarbol, el
script muestra esos dependientes y pregunta si tambien se omiten (por defecto
si), para evitar que Odoo los vuelva a arrastrar.

COBERTURA Y BASE DE DATOS
-------------------------
La ejecucion siempre corre bajo 'coverage' (igual que scripts/coverage):
instala el paquete coverage dentro del contenedor, mide los modulos
instalados (--source) y al terminar imprime el reporte con el porcentaje
total.

Si no se pasa -d/--db, se autogenera un nombre unico (test_<modulo>_<fecha>).
En ambos casos (nombre dado o autogenerado): si la base no existe se crea, y
al finalizar se borra, salvo que se pase --no-rm-db.

Con --out-coverage-json <ruta> se exporta ademas el reporte de cobertura en
formato JSON (coverage json). Si <ruta> es un directorio (existente o
terminado en '/'), el archivo se llama coverage.json dentro de el; si no,
<ruta> se usa tal cual como nombre de archivo (ej: ./mi_reporte.json).

REQUISITOS PARA SU EJECUCION
----------------------------
  * La instancia indicada debe existir en instances.json y su contenedor
    (odoo-<instancia>) debe estar en ejecucion.
  * El archivo de configuracion dentro del contenedor:
    /home/odoo/.config/odoo.conf

EJEMPLOS
--------
  ./scripts/odoo-test integra-17 binaural_brand
  ./scripts/odoo-test integra-17 binaural_brand -d testing
  ./scripts/odoo-test integra-17 binaural_brand --tags /binaural_brand/test_costos
  ./scripts/odoo-test integra-17 binaural_brand,binaural_mobile
  ./scripts/odoo-test -i integra-17 -m binaural_brand
  ./scripts/odoo-test -i integra-17 -m binaural_brand,binaural_mobile
  ./scripts/odoo-test integra-17 binaural_brand --recursive
  ./scripts/odoo-test integra-17 binaural_brand --recursive --exclude binaural_mobile,binaural_commissions
  ./scripts/odoo-test integra-17 binaural_brand --no-rm-db
  ./scripts/odoo-test integra-17 binaural_brand --out-coverage-json ./reportes
  ./scripts/odoo-test integra-17 binaural_brand --out-coverage-json ./mi_reporte.json
  ./scripts/odoo-test integra-17 binaural_brand --dry-run
"""


def parse_manifest_depends(manifest_path):
    """Extrae la lista 'depends' de un manifest sin ejecutar codigo."""
    try:
        tree = ast.parse(Path(manifest_path).read_text(encoding="utf-8"))
    except (SyntaxError, UnicodeDecodeError, OSError):
        return []
    for node in ast.walk(tree):
        if isinstance(node, ast.Dict):
            for key, value in zip(node.keys, node.values):
                if isinstance(key, ast.Constant) and key.value == "depends":
                    if isinstance(value, ast.List):
                        return [elt.value for elt in value.elts
                                if isinstance(elt, ast.Constant)
                                and isinstance(elt.value, str)]
    return []


def scan_modules(src_roots):
    """Escanea los addons y devuelve:
       modules:  dict modulo -> set(depends en otros modulos escaneados)
       reverse:  dict modulo -> set(modulos que dependen de el)
       paths:    dict modulo -> ruta local (host) de la carpeta del modulo"""
    manifest_paths = {}
    for root in src_roots:
        if not os.path.isdir(root):
            continue
        for dirpath, dirnames, filenames in os.walk(root):
            if "__manifest__.py" in filenames:
                manifest_paths[Path(dirpath).name] = Path(dirpath) / "__manifest__.py"
            dirnames.sort()

    modules = {name: set() for name in manifest_paths}
    reverse = {name: set() for name in manifest_paths}
    for name, manifest in manifest_paths.items():
        for dep in parse_manifest_depends(manifest):
            if dep in modules and dep != name:
                modules[name].add(dep)
                reverse[dep].add(name)
    paths = {name: str(manifest.parent) for name, manifest in manifest_paths.items()}
    return modules, reverse, paths


def container_source_path(local_path, base_path):
    """Convierte una ruta local (host) bajo BASE_PATH a su equivalente dentro
    del contenedor Odoo (montado via ./src:/home/odoo/src)."""
    rel = os.path.relpath(local_path, base_path)
    return f"/home/odoo/{rel}"


def generate_db_name(module):
    """Nombre unico para una base de datos de test (limite Postgres: 63 chars)."""
    ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    safe_module = re.sub(r"[^a-zA-Z0-9_]", "_", module)[:30]
    return f"test_{safe_module}_{ts}"[:63]


def db_exists(container, db_name):
    cmd = [
        "docker", "exec", container, "psql", "-d", "postgres", "-tAc",
        f"SELECT 1 FROM pg_database WHERE datname='{db_name}'",
    ]
    result = subprocess.run(cmd, capture_output=True, text=True)
    return result.stdout.strip() == "1"


def create_db(container, db_name):
    print(f"→ Creando base de datos '{db_name}' en {container}...")
    subprocess.run(["docker", "exec", container, "createdb", db_name], check=True)


def drop_db(container, db_name):
    print(f"→ Borrando base de datos '{db_name}' en {container}...")
    subprocess.run(["docker", "exec", container, "dropdb", "--if-exists", db_name], check=False)


def resolve_coverage_json_path(out_arg):
    """Si out_arg es un directorio (existente o terminado en '/'), el
    destino es <out_arg>/coverage.json; si no, out_arg es el nombre del
    archivo completo, tal cual lo dio el usuario (ej: ./mi_reporte.json)."""
    if out_arg.endswith(os.sep) or os.path.isdir(out_arg):
        directory = out_arg.rstrip(os.sep) or os.sep
        return os.path.join(directory, "coverage.json")
    return out_arg


def export_coverage_json(container, container_json_path, dest_path):
    """Copia el coverage.json generado dentro del contenedor hacia dest_path
    (crea el directorio contenedor si no existe)."""
    parent = os.path.dirname(dest_path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    result = subprocess.run(
        ["docker", "cp", f"{container}:{container_json_path}", dest_path],
        capture_output=True, text=True,
    )
    if result.returncode == 0:
        print(f"→ Reporte JSON de cobertura guardado en: {dest_path}")
    else:
        print(f"⚠ No se pudo exportar el reporte JSON: {result.stderr.strip()}")


def transitive_closure(seed_modules, modules, reverse):
    """Union transitiva de dependencias (sube) y dependientes (baja) de una
    lista de modulos semilla."""
    seen = set()

    def walk(start, graph):
        stack = [start]
        while stack:
            cur = stack.pop()
            for nxt in graph.get(cur, ()):
                if nxt not in seen:
                    seen.add(nxt)
                    stack.append(nxt)

    seen.update(seed_modules)
    for module in seed_modules:
        walk(module, modules)
        walk(module, reverse)
    return sorted(seen)


def dependents_within(excluded, closure, reverse):
    """Modulos del subarbol que dependen (transitivamente) de algun excluido."""
    result = set()
    excluded = set(excluded)
    closure = set(closure)
    for ex in excluded:
        stack = list(reverse.get(ex, ()))
        seen = set()
        while stack:
            cur = stack.pop()
            if cur in seen:
                continue
            seen.add(cur)
            if cur in closure and cur not in excluded:
                result.add(cur)
            stack.extend(reverse.get(cur, ()))
    return sorted(result)


def dependency_set(seed_modules, graph):
    """Cierre transitivo de graph desde una lista de modulos semilla (sin
    incluir a los propios modulos semilla)."""
    seen = set()
    stack = []
    for module in seed_modules:
        stack.extend(graph.get(module, ()))
    while stack:
        cur = stack.pop()
        if cur in seen:
            continue
        seen.add(cur)
        stack.extend(graph.get(cur, ()))
    return sorted(seen - set(seed_modules))


MAX_ITEMS_PER_LINE = 5


def chunk_items(items, size=MAX_ITEMS_PER_LINE):
    return [items[i:i + size] for i in range(0, len(items), size)]


def wrap_list_lines(items, size=MAX_ITEMS_PER_LINE):
    """Lista de items -> lineas 'a, b, c, ...' de a lo sumo `size` items c/u."""
    return [", ".join(group) for group in chunk_items(items, size)]


def print_boxed(title, blocks):
    """Dibuja un cuadro con un titulo y varios bloques de lineas, separados
    entre si por un divisor horizontal dentro del mismo cuadro."""
    all_lines = [title] + [line for block in blocks for line in block]
    width = max(len(line) for line in all_lines) + 2
    border = "─" * width
    print(f"\n┌{border}┐")
    print(f"│ {title.ljust(width - 1)}│")
    for block in blocks:
        print(f"├{border}┤")
        for line in block:
            print(f"│ {line.ljust(width - 1)}│")
    print(f"└{border}┘")


def print_recursive_overview(seed_modules, closure, excluded, modules, reverse):
    """Muestra en un solo cuadro: el subarbol completo, el arbol de
    dependencias (descendente/ascendente) y los modulos omitidos, con a lo
    sumo MAX_ITEMS_PER_LINE modulos por linea."""
    modules_label = ", ".join(seed_modules)

    descendente = dependency_set(seed_modules, modules)
    ascendente = dependency_set(seed_modules, reverse)

    blocks = [
        wrap_list_lines(closure),
        ["Descendente (de los que depende):"] + (wrap_list_lines(descendente) if descendente else ["(ninguno)"]),
        ["Ascendente  (que dependen de el):"] + (wrap_list_lines(ascendente) if ascendente else ["(ninguno)"]),
    ]
    if excluded:
        blocks.append(["Modulos omitidos:"] + wrap_list_lines(sorted(excluded)))

    print_boxed(f"Subarbol de '{modules_label}' ({len(closure)} modulos)", blocks)


def run_and_capture(cmd):
    """Corre cmd, muestra su salida en vivo y la devuelve completa para parsear."""
    process = subprocess.Popen(
        cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1
    )
    lines = []
    for line in process.stdout:
        print(line, end="")
        lines.append(line)
    process.wait()
    return process.returncode, "".join(lines)


def print_test_summary(module, db_name, output):
    """Parsea la salida de Odoo/coverage y muestra un resumen final prolijo."""
    result_match = re.search(
        r"(\d+) failed, (\d+) error\(s\) of (\d+) tests", output
    )
    coverage_match = re.search(r"^TOTAL\b.*?(\d+)%\s*$", output, re.MULTILINE)

    rows = [f"RESUMEN — {module}"]
    if result_match:
        failed, errors, tests_run = (int(x) for x in result_match.groups())
        ok = failed == 0 and errors == 0
        icon = "✅" if ok else "❌"
        estado = "OK" if ok else "CON FALLOS"
        rows += [
            f"Tests ejecutados : {tests_run}",
            f"Fallos           : {failed}",
            f"Errores          : {errors}",
            f"Resultado        : {icon} {estado}",
        ]
    else:
        rows.append("(no se detecto el resumen de tests de Odoo)")
    rows.append(
        f"Cobertura        : {coverage_match.group(1)}%"
        if coverage_match else "Cobertura        : (no disponible)"
    )
    rows.append(f"Base de datos    : {db_name}")

    width = max(len(r) for r in rows) + 2
    border = "─" * width
    print(f"\n┌{border}┐")
    print(f"│ {rows[0].ljust(width - 1)}│")
    print(f"├{border}┤")
    for row in rows[1:]:
        print(f"│ {row.ljust(width - 1)}│")
    print(f"└{border}┘\n")


def confirm_recursive_run(closure):
    """Pide confirmacion explicita antes de correr el arbol completo (default: NO)."""
    answer = input(
        f"\nEsto instalara y medira cobertura de {len(closure)} modulos. "
        "Continuar? [s/N]: "
    ).strip().lower()
    if answer not in ("s", "si", "sí", "y", "yes"):
        print("Cancelado.")
        sys.exit(0)


def resolve_src_roots(base_path, instance, config):
    """Raices de addons reales de la instancia desde instances.json."""
    if instance in config["instances"]:
        addons = config["instances"][instance].get(
            "overwrite_odoo_config", {}).get("addons", [])
    else:
        addons = []
        for inst in config["instances"].values():
            addons.extend(inst.get("overwrite_odoo_config", {}).get("addons", []))
    return [str(Path(base_path) / a) for a in addons if os.path.isdir(Path(base_path) / a)]


def run_command():
    parser = argparse.ArgumentParser(
        description=USAGE,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        usage="odoo-test [<instancia>] [<modulo>[,<modulo2>,...]] [-i instancia] "
              "[-m modulos] [-d <base_de_datos>] [opciones]",
    )
    parser.add_argument(
        "instance", nargs="?", default=None,
        help="Instancia del proyecto docker-odoo (ej: integra-17). "
             "Alternativa: -i/--instance."
    )
    parser.add_argument(
        "module", nargs="?", default=None,
        help="Nombre del modulo, o varios separados por coma "
             "(ej: binaural_brand,binaural_mobile). Alternativa: -m/--modules."
    )
    parser.add_argument(
        "-i", "--instance", dest="instance_flag", default=None, metavar="INSTANCIA",
        help="Instancia (alternativa al posicional)."
    )
    parser.add_argument(
        "-m", "--modules", dest="module_flag", default=None, metavar="MODULOS",
        help="Modulo(s), separados por coma (alternativa al posicional)."
    )
    parser.add_argument(
        "-d", "--db", default=None, metavar="BASE",
        help="Nombre de la base de datos (opcional). Si se omite, se autogenera "
             "un nombre unico. En ambos casos: se crea si no existe y se borra "
             "al terminar salvo --no-rm-db."
    )
    parser.add_argument(
        "--tags", default="all",
        help="'all' (por defecto) ejecuta los tests del subarbol completo. "
             "Cualquier otro valor se pasa tal cual a odoo --test-tags."
    )
    parser.add_argument(
        "--recursive", action="store_true",
        help="Calcula el subarbol completo de dependencias (dependientes + "
             "dependencias), muestra el arbol y pide confirmacion antes de "
             "ejecutar. Sin este flag, solo se instala/testea el modulo indicado."
    )
    parser.add_argument(
        "--exclude", default="",
        help="Modulos a omitir del subarbol, separados por coma "
             "(ej: binaural_mobile,binaural_commissions). Solo tiene efecto "
             "junto con --recursive."
    )
    parser.add_argument(
        "--no-rm-db", action="store_true",
        help="No borra la base de datos al terminar (por defecto se borra)."
    )
    parser.add_argument("--dry-run", action="store_true",
                        help="Solo muestra el comando sin ejecutarlo (no toca Docker/DB)")
    parser.add_argument(
        "--out-coverage-json", default=None, metavar="RUTA",
        help="Exporta el reporte de cobertura en formato JSON (coverage json). "
             "Si RUTA es un directorio (existente o terminado en '/'), el "
             "archivo se llama coverage.json dentro de el; si no, RUTA se usa "
             "tal cual como nombre de archivo (ej: ./mi_reporte.json)."
    )
    args = parser.parse_args()

    args.instance = args.instance_flag or args.instance
    args.module = args.module_flag or args.module
    if not args.instance or not args.module:
        parser.error(
            "Debes indicar instancia y modulo(s), por posicional "
            "(odoo-test <instancia> <modulo>) o con -i/-m."
        )

    config = load_config(BASE_PATH)
    if args.instance not in config["instances"]:
        print(f"Error: instancia '{args.instance}' no existe")
        print("Instancias disponibles:")
        for name in config["instances"]:
            print(f"  - {name}")
        sys.exit(1)

    src_roots = resolve_src_roots(BASE_PATH, args.instance, config)
    if not src_roots:
        print("Error: no se encontraron directorios de addons para la instancia.")
        sys.exit(1)

    modules, reverse, module_paths = scan_modules(src_roots)
    modules_arg = [m.strip() for m in args.module.split(",") if m.strip()]
    missing = [m for m in modules_arg if m not in modules]
    if missing:
        print(f"Error: el/los modulo(s) {', '.join(missing)} no existen en los "
              "addons escaneados:")
        print(f"  {', '.join(src_roots)}")
        sys.exit(1)

    excluded = {m.strip() for m in args.exclude.split(",") if m.strip()}
    modules_label = ", ".join(modules_arg)

    if not args.recursive:
        closure = modules_arg
        test_tags = args.tags if args.tags != "all" else ",".join(f"/{m}" for m in modules_arg)
        modules_str = ",".join(modules_arg)
        print(f"Modo no recursivo: solo se ejecuta(n) '{modules_label}' "
              "(usa --recursive para el arbol completo de dependencias)")
    else:
        closure = transitive_closure(modules_arg, modules, reverse)
        closure = [m for m in closure if m not in excluded]
        dragged = [d for d in dependents_within(excluded, closure, reverse)
                   if d not in modules_arg]
        if dragged:
            print("Los siguientes modulos dependen de los excluidos y volverian a")
            print("arrastrarlos de vuelta a los tests:")
            for i, dep in enumerate(dragged, 1):
                print(f"  {i}) {dep}")
            if args.dry_run:
                print("(en la ejecucion real se preguntara si omitirlos)")
            else:
                answer = input("Omitirlos tambien? [si/no] (por defecto si): ").strip().lower()
                if answer not in ("no", "n"):
                    excluded.update(dragged)
                    closure = [m for m in closure if m not in excluded]
        test_tags = ",".join(f"/{m}" for m in closure) if args.tags == "all" else args.tags
        modules_str = ','.join(closure)

        print_recursive_overview(modules_arg, closure, excluded, modules, reverse)
        if args.dry_run:
            print("\n(dry-run: no se pedira confirmacion)")
        else:
            confirm_recursive_run(closure)

    db_name = args.db or generate_db_name("_".join(modules_arg))
    container = f"odoo-{args.instance}"

    source_paths = ",".join(
        container_source_path(module_paths[m], BASE_PATH)
        for m in closure if m in module_paths
    )
    # --workers 0 es necesario para que se vea el resumen final de tests
    # ("X failed, Y error(s) of Z tests") y para que la cobertura se mida
    # bien. Sin este flag, ninguna de las dos cosas funciona:
    #
    # Ese resumen lo imprime Odoo desde un solo lugar de su codigo fuente:
    # ThreadedServer.run() en odoo/service/server.py, y solo cuando se usa
    # --stop-after-init junto con tests habilitados (test_enable=True, que
    # Odoo activa solo al pasar --test-tags). Ese metodo hace:
    #
    #   if stop:
    #       if config['test_enable']:
    #           logger = odoo.tests.result._logger
    #           for db, registry in Registry.registries.d.items():
    #               report = registry._assertion_report
    #               log = logger.error if not report.wasSuccessful() \
    #                else logger.warning if not report.testsRun \
    #                else logger.info
    #               log("%s when loading database %r", report, db)
    #
    # El problema es que Odoo no siempre usa ThreadedServer: en
    # server.py:start(), si config['workers'] es distinto de 0, se instancia
    # PreforkServer en su lugar (el modo con procesos hijos "forkeados" que
    # usa Odoo en produccion), y esa clase no tiene nada parecido a este
    # bloque — el resumen simplemente nunca se imprime ahi, sea cual sea el
    # nivel de log.
    #
    # Cada instancia trae WORKERS=2 por defecto en su odoo.conf (ver
    # compose_generator.py), asi que sin este --workers 0 explicito, Odoo
    # heredaria ese valor y correria en modo Prefork. Como efecto adicional,
    # en ese modo los tests corren dentro de un proceso hijo forkeado que el
    # `coverage run` del proceso padre no puede trazar, asi que el % de
    # cobertura reportado tampoco seria confiable.
    odoo_cmd = (
        f"odoo --test-tags {test_tags} -d {db_name} -i {modules_str} "
        "--without-demo=True --stop-after-init --workers 0 --no-http "
        "-c /home/odoo/.config/odoo.conf"
    )
    container_json_path = f"/tmp/coverage_{db_name}.json"
    coverage_json_dest = (
        resolve_coverage_json_path(args.out_coverage_json) if args.out_coverage_json else None
    )
    json_step = f"python3 -m coverage json -o {container_json_path}; " if coverage_json_dest else ""
    inner_cmd = (
        "pip3 install --quiet coverage && python3 -m coverage erase && "
        f"python3 -m coverage run --rcfile=/home/odoo/.coveragerc --source={source_paths} "
        f"/usr/bin/{odoo_cmd}; "
        f"test_rc=$?; python3 -m coverage report -m; {json_step}exit $test_rc"
    )
    full_cmd = ["docker", "exec", "-u", "root", container, "bash", "-c", inner_cmd]

    print("\nComando de ejecucion:")
    print(f"  docker exec -u root {container} bash -c \"")
    print(f"    pip3 install --quiet coverage &&")
    print(f"    python3 -m coverage erase &&")
    print(f"    python3 -m coverage run --rcfile=/home/odoo/.coveragerc \\")
    print(f"      --source={source_paths} \\")
    print(f"      /usr/bin/{odoo_cmd};")
    print(f"    python3 -m coverage report -m")
    if coverage_json_dest:
        print(f"    python3 -m coverage json -o {container_json_path}")
    print("  \"")
    print(f"\nBase de datos: {db_name}"
          f"{' (se conservara: --no-rm-db)' if args.no_rm_db else ' (se borrara al terminar)'}")
    if coverage_json_dest:
        print(f"Reporte JSON: se exportara a {coverage_json_dest}")
    print()

    if args.dry_run:
        return

    if not db_exists(container, db_name):
        create_db(container, db_name)
    else:
        print(f"→ Reutilizando base de datos existente '{db_name}'")

    exit_code = 0
    try:
        print("Ejecutando tests con cobertura...")
        exit_code, output = run_and_capture(full_cmd)
        print_test_summary(modules_label, db_name, output)
        if coverage_json_dest:
            export_coverage_json(container, container_json_path, coverage_json_dest)
    finally:
        if args.no_rm_db:
            print(f"--no-rm-db: se conserva la base de datos '{db_name}'")
        else:
            drop_db(container, db_name)

    sys.exit(exit_code)


if __name__ == "__main__":
    run_command()
