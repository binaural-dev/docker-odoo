#!/usr/bin/env python3
"""
Actualiza ir_config_parameter después de restaurar una BD de testing.
Cambia el Environment a 'qa' para evitar procesos de producción.
"""

import argparse
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(
        description="Actualiza ir_config_parameter post-restore"
    )
    parser.add_argument("--container", required=True)
    parser.add_argument("--db-name", required=True)
    parser.add_argument("--db-user", default="odoo")
    parser.add_argument("--db-host", default="host.docker.internal")
    parser.add_argument("--db-port", type=int, default=5432)
    args = parser.parse_args()

    sql = "UPDATE ir_config_parameter SET value = 'qa' WHERE key = 'Environment';"

    cmd = [
        "docker", "exec", args.container,
        "psql",
        "-U", args.db_user,
        "-h", args.db_host,
        "-p", str(args.db_port),
        "-d", args.db_name,
        "-c", sql,
    ]

    result = subprocess.run(cmd, capture_output=True, text=True)

    if result.returncode != 0:
        print(f"ERROR: {result.stderr}", file=sys.stderr)
        sys.exit(1)

    print(result.stdout)
    print("Parametro 'Environment' actualizado a 'qa'")


if __name__ == "__main__":
    main()
