#!/usr/bin/env python3
"""
Sync /etc/hosts with the local subdomains declared in ``instances.json``.

For every enabled instance, an entry like ``127.0.0.1 <inst_name>.local`` is
added (idempotently). Optional services (pgadmin, mailhog) are added when
their ``enabled`` flag is true.

The script is safe to run repeatedly: it removes any line it previously added
(marked with a ``# odoo-managed`` sentinel) before re-adding the current set.
This means the user can enable/disable instances in ``instances.json`` and
the host file stays in sync with whatever is currently active.

Requires root to modify ``/etc/hosts``; uses ``sudo`` if it is not already
running as root.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

BASE_PATH = Path(__file__).resolve().parent.parent
INSTANCES_FILE = BASE_PATH / "instances.json"
HOSTS_FILE = Path("/etc/hosts")
SENTINEL = "# odoo-managed"
# Match the full managed block, from a sentinel line to the next blank line.
BLOCK_RE = re.compile(
    rf"{{SENTINEL}}\n(?:.*\n)*?\n".replace("{SENTINEL}", re.escape(SENTINEL)),
    re.MULTILINE,
)


def load_instances() -> dict:
    with INSTANCES_FILE.open("r") as f:
        return json.load(f)


def collect_subdomains(config: dict) -> list[str]:
    """Build the list of ``*.local`` subdomains that should resolve to
    ``127.0.0.1`` based on the current state of ``instances.json``.
    """
    subdomains = []
    for inst_name, inst_conf in config.get("instances", {}).items():
        if inst_conf.get("enabled", True):
            subdomains.append(f"{inst_name}.local")

    if config.get("pgadmin", {}).get("enabled", False):
        subdomains.append("pgadmin.local")
    if config.get("mailhog", {}).get("enabled", False):
        subdomains.append("mailhog.local")
    return subdomains


def render_block(subdomains: list[str]) -> str:
    """Render the managed block that we will inject into /etc/hosts."""
    if not subdomains:
        return ""
    lines = [SENTINEL, "# Auto-generated by scripts/odoo_hosts — do not edit."]
    # Deduplicate while keeping order.
    seen = set()
    for sub in subdomains:
        if sub in seen:
            continue
        seen.add(sub)
        lines.append(f"127.0.0.1 {sub}")
    return "\n".join(lines) + "\n"


def strip_managed_block(contents: str) -> str:
    """Remove any previous managed block from the file contents."""
    # We look for the sentinel line and remove everything from there up to
    # (but not including) the next blank line that ends the block.
    pattern = re.compile(
        rf"^{re.escape(SENTINEL)}\n(?:.*\n)*?\n",
        re.MULTILINE,
    )
    return pattern.sub("", contents)


def build_new_hosts(contents: str, block: str) -> str:
    """Remove the previous managed block, then append the new one (if any)."""
    contents = strip_managed_block(contents)
    if not block:
        return contents.rstrip() + "\n"
    return contents.rstrip() + "\n\n" + block


def write_hosts(contents: str, dry_run: bool) -> None:
    if dry_run:
        print("---- DRY RUN: would write ----")
        print(contents)
        return

    if os.geteuid() != 0:
        print(
            "Error: /etc/hosts requiere root. Corré con sudo:\n"
            "    sudo python3 scripts/odoo_hosts",
            file=sys.stderr,
        )
        sys.exit(1)

    HOSTS_FILE.write_text(contents)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Sincroniza /etc/hosts con los subdominios de las instances"
    )
    parser.add_argument(
        "--dry-run", action="store_true",
        help="Muestra lo que haría sin tocar /etc/hosts",
    )
    parser.add_argument(
        "--show", action="store_true",
        help="Solo muestra los subdominios que se agregarían",
    )
    args = parser.parse_args()

    if not INSTANCES_FILE.exists():
        print(f"Error: {INSTANCES_FILE} no encontrado.", file=sys.stderr)
        return 1

    config = load_instances()
    subdomains = collect_subdomains(config)

    if args.show:
        for s in subdomains:
            print(s)
        return 0

    block = render_block(subdomains)
    current = HOSTS_FILE.read_text() if HOSTS_FILE.exists() else ""
    new_contents = build_new_hosts(current, block)

    write_hosts(new_contents, dry_run=args.dry_run)

    if args.dry_run:
        return 0

    print(f"Sincronizado /etc/hosts ({len(subdomains)} subdominio(s) activo(s)):")
    for s in subdomains:
        print(f"  - {s}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
