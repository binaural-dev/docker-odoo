{
  "permissions": {
    "allow": [
      "mcp__engram__mem_search",
      "mcp__engram__mem_get_observation",
      "mcp__engram__mem_context",
      "mcp__engram__mem_save",
      "mcp__engram__mem_session_start",
      "mcp__engram__mem_session_finalize",
      "mcp__engram__mem_session_end",
      "mcp__engram__mem_judge"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/engram_claude_hook.py\"", "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/engram_claude_hook.py\"", "timeout": 30 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/hooks/engram_claude_hook.py\"", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/sdd_tool_guard.py\"", "timeout": 30 }
        ]
      }
    ]
  }
}
